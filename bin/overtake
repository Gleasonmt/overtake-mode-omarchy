#!/bin/bash
# Switch Omarchy between its own layout and Overtake Mode, a classic desktop: bottom taskbar
# (overtake.taskbar), a date-and-time clock, familiar shortcuts (~/.config/hypr/overtake.lua)
# and a wallpaper slideshow.
#
#   overtake on|off|toggle|status
#   overtake show-desktop     # SUPER+D: jump to an empty workspace and back
#   overtake theme-picker [omarchy|custom|all]  # pick a theme from one folder; prints its name
#   overtake next-wallpaper   # SUPER+CTRL+ALT+SPACE: next slideshow wallpaper
#   overtake wallpaper-mode [rotate|day-night]   # pick or print the slideshow mode
#   overtake minimize|maximize|close [address]  # active window when no address
#   overtake restore <address> | restore-all
#   overtake focus-app <name>      # go to an app's window on its own workspace (restoring it if minimized)
#   overtake notification-open <app> <app icon> <message>  # notification center click without its own action
#   overtake minimize-all [monitor]   # clicking the desktop: minimize this workspace's windows
#   overtake screensaver <on|off|enabled|start|lock|show|showing|preview> [...]  # Settings > Screensaver
#   overtake hide-minimized   # taskbar: hide the minimized windows' workspace if it gets shown
#   overtake show <address>   # taskbar click: bring on screen if needed, then focus
#   overtake float-all        # float any tiled window (floating ones always cover tiled ones)
#   overtake remember | relayout  # record window places; restore them after a screen change
#   overtake rescue           # move floating windows no screen shows back into view
#   overtake make-room <address>  # move a window down so its title bar fits above it
#   overtake snap <left|right|top-left|top-right|bottom-left|bottom-right|full> [address]
#   overtake unsnap <address> # back to the size it had before snapping
#   overtake start [quick]    # Super+S / Super+X: open the Start menu or its quick-link menu
#   overtake settings [page]  # Super+I: the Settings window (system, bluetooth, network, ...)
#   overtake snap-layouts     # SUPER+Z: show the snap layouts for the focused window
#   overtake taskbar-position <left|center>  # right-click Start: where the taskbar sits on the bar
#   overtake copy-url <address>  # title bar menu: copy a browser window's page address
#   overtake rename <address>    # taskbar menu: bring a window up with its title bar tab ready to rename
#   overtake open-url <url>      # links from other apps: open on this workspace, not the browser's last window
#   overtake resume           # at login: restart the slideshow if the mode is on

set -euo pipefail

SHELL_JSON="$HOME/.config/omarchy/shell.json"
STATE_DIR="$HOME/.local/state/overtake"
FLAG="$STATE_DIR/enabled"
SAVED_BAR="$STATE_DIR/omarchy-bar.json"
DESKTOP_RETURN="$STATE_DIR/desktop-return"

SLIDESHOW_DIR="$HOME/Pictures/overtake/slideshow"
SLIDESHOW_MINUTES=15
CURRENT_BG="$HOME/.local/state/omarchy/current/background"
SAVED_BG="$STATE_DIR/omarchy-background"
SLIDE_INDEX="$STATE_DIR/slide-index"
SLIDESHOW_PID="$STATE_DIR/slideshow.pid"
WALLPAPER_MODE_FILE="$STATE_DIR/wallpaper-mode"
MINIMIZED="$STATE_DIR/minimized.json"
LAYOUT="$STATE_DIR/layout.json"     # each floating window's place as fractions of its screen
ZONES="$STATE_DIR/zones.json"       # snapped windows: address -> {ws, zone, restore: [w, h]}
KEEP_FLOATING="$STATE_DIR/kept-floating.json"  # windows already floating before `on`; `off` tiles all the others
TASKBAR_SETTINGS="$STATE_DIR/taskbar-settings.json"  # taskbar pins etc., kept while the mode is off
SAVED_GTK_BUTTONS="$STATE_DIR/gtk-button-layout"  # GTK apps' own title-bar buttons, restored on off
SNAP_GAP=12
SNAP_TITLE_BAR=32                   # room left above a snapped window for its title bar
SNAP_STACK_MAX=3
DAY_IMAGE="$SLIDESHOW_DIR/1-hills-day.png"
NIGHT_IMAGE="$SLIDESHOW_DIR/2-hills-night.png"

WINDOWS_BAR='{
  "position": "bottom",
  "transparent": false,
  "centerAnchor": "overtake.workspaces",
  "layout": {
    "left": [{ "id": "overtake.taskbar", "iconSize": 22 }],
    "center": [{ "id": "overtake.workspaces" }],
    "right": [
      { "id": "omarchy.system-update" },
      { "id": "omarchy.tray" },
      { "id": "omarchy.agents" },
      { "id": "omarchy.keyboard-layout" },
      { "id": "overtake.bluetooth" },
      { "id": "omarchy.network" },
      { "id": "overtake.audio" },
      { "id": "omarchy.power" },
      { "id": "omarchy.clock", "format": "h:mm AP   M/d/yyyy", "formatAlt": "dddd, MMMM d, yyyy", "verticalFormat": "h\n—\nmm" },
      { "id": "omarchy.indicators", "items": ["Dictation", "ScreenRecording", "Reminder", "NightLight", "StayAwake"] },
      { "id": "overtake.notification-center" }
    ]
  }
}'

SHELL_TOML="$HOME/.config/omarchy/shell.toml"
TOML_BEGIN="# >>> overtake (managed by ~/.local/bin/overtake)"
TOML_END="# <<< overtake"

notify() { omarchy-notification-send -g "$1" "$2" >/dev/null 2>&1 || true; }

# Taller taskbar (Omarchy default is 26), kept in a marked block
# of the machine-level shell.toml so turning the mode off removes exactly it.
add_bar_size() {
  remove_bar_size
  printf '%s\n[bar]\nsize-horizontal = 40\nicon-font = 15\n%s\n' "$TOML_BEGIN" "$TOML_END" >>"$SHELL_TOML"
}

remove_bar_size() {
  [[ -f $SHELL_TOML ]] || return 0
  local tmp
  tmp=$(mktemp)
  awk -v b="$TOML_BEGIN" -v e="$TOML_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$SHELL_TOML" >"$tmp"
  cat "$tmp" >"$SHELL_TOML"
  rm -f "$tmp"
}

# Rewrite shell.json in place (not a rename) so the shell's file watcher sees it.
set_bar() {
  local tmp
  tmp=$(mktemp)
  jq --argjson bar "$1" '.bar = $bar' "$SHELL_JSON" >"$tmp"
  cat "$tmp" >"$SHELL_JSON"
  rm -f "$tmp"
}

next_wallpaper() {
  local slides=() index=-1
  shopt -s nullglob
  slides=("$SLIDESHOW_DIR"/*)
  shopt -u nullglob
  (( ${#slides[@]} )) || return 0
  [[ -s $SLIDE_INDEX ]] && index=$(<"$SLIDE_INDEX")
  index=$(( (index + 1) % ${#slides[@]} ))
  echo "$index" >"$SLIDE_INDEX"
  omarchy-theme-bg-set "${slides[$index]}" >/dev/null 2>&1 || true
}

wallpaper_mode() {
  [[ -s $WALLPAPER_MODE_FILE ]] && cat "$WALLPAPER_MODE_FILE" || echo rotate
}

# Today's sunrise and sunset as HHMM, from wttr.in's IP-located astronomy data
# (the same source Omarchy's weather widget uses), cached per day. Falls back to
# 07:00/19:00 when offline.
sun_times() {
  local cache="$STATE_DIR/sun-$(date +%F)" times
  if [[ ! -s $cache ]]; then
    rm -f "$STATE_DIR"/sun-*
    times=$(curl -fsS --max-time 8 'https://wttr.in/?format=j1' 2>/dev/null |
      jq -r '.weather[0].astronomy[0] | "\(.sunrise)|\(.sunset)"' 2>/dev/null) || true
    if [[ $times == *"|"* ]]; then
      echo "$(date -d "${times%%|*}" +%H%M) $(date -d "${times##*|}" +%H%M)" >"$cache"
    else
      echo "0700 1900"
      return
    fi
  fi
  cat "$cache"
}

apply_day_night() {
  local sunrise sunset now image
  read -r sunrise sunset < <(sun_times)
  now=$(date +%H%M)
  if (( 10#$now >= 10#$sunrise && 10#$now < 10#$sunset )); then image=$DAY_IMAGE; else image=$NIGHT_IMAGE; fi
  [[ $(readlink -f "$CURRENT_BG") == "$(readlink -f "$image")" ]] || omarchy-theme-bg-set "$image" >/dev/null 2>&1 || true
}

refresh_wallpaper() {
  if [[ $(wallpaper_mode) == day-night ]]; then apply_day_night; else next_wallpaper; fi
}

set_wallpaper_mode() {
  case "$1" in
    rotate | day-night) ;;
    *) echo "Usage: overtake wallpaper-mode [rotate|day-night]" >&2; exit 1 ;;
  esac
  mkdir -p "$STATE_DIR"
  echo "$1" >"$WALLPAPER_MODE_FILE"
  if [[ -f $FLAG ]]; then
    refresh_wallpaper
    start_slideshow
  fi
  [[ $1 == day-night ]] && notify $'' "Wallpaper: Day & Night (follows sunrise and sunset)" ||
    notify $'' "Wallpaper: Rotate (every $SLIDESHOW_MINUTES minutes)"
}

stop_slideshow() {
  # the loop runs in its own session (setsid), so its group is the loop and
  # its sleep: stop both
  if [[ -s $SLIDESHOW_PID ]] && kill -0 "$(<"$SLIDESHOW_PID")" 2>/dev/null; then
    kill -- "-$(<"$SLIDESHOW_PID")" 2>/dev/null || kill "$(<"$SLIDESHOW_PID")" 2>/dev/null || true
  fi
  rm -f "$SLIDESHOW_PID"
}

start_slideshow() {
  (
    flock 7
    stop_slideshow
    # (without the lock's handle; the loop records its own pid: $! would be
    # setsid's, which can fork and exit, leaving the loop unstoppable)
    setsid overtake slideshow-loop </dev/null >/dev/null 2>&1 7>&- &
  ) 7>"$STATE_DIR/.slideshow.lock"
}

# A theme's live (animated) wallpaper: <theme>/live/<name>.frag.qsb next to
# <theme>/backgrounds/<name>.*, drawn by the live-wallpaper shell plugin. The
# slideshow leaves one alone; next-wallpaper still switches away by hand.
live_wallpaper_showing() {
  local bg
  bg=$(readlink -f "$CURRENT_BG" 2>/dev/null) || return 1
  [[ $bg == */backgrounds/* ]] || return 1
  local name=${bg##*/}
  [[ -f ${bg%/backgrounds/*}/live/${name%.*}.frag.qsb ]]
}

# Rotate changes the picture every SLIDESHOW_MINUTES; Day & Night only checks
# every 5 minutes whether the sun has come up or gone down.
slideshow_loop() {
  echo $$ >"$SLIDESHOW_PID"
  while [[ -f $FLAG ]]; do
    if [[ $(wallpaper_mode) == day-night ]]; then
      sleep 300 && [[ -f $FLAG ]] && ! live_wallpaper_showing && apply_day_night
    else
      sleep $(( SLIDESHOW_MINUTES * 60 )) && [[ -f $FLAG ]] && ! live_wallpaper_showing && next_wallpaper
    fi
  done
}

# Overtake's patched copies of two Omarchy services, enabled by the installer
# and kept loaded in both modes (they check the mode themselves, so switching
# needs no shell restart); `switch_services off` hands back Omarchy's own:
# overtake.notifications (close buttons, the notification center's timings and
# per-app settings) and overtake.battery (no fixed 10% warning; BatteryAlerts
# sends per-device ones). Omarchy keeps a service loaded until the shell
# restarts, so switching restarts the shell (only when something changed)
# and waits for it to come back.
switch_services() {  # switch_services on|off
  local listed id enabled changed=0
  listed=$(omarchy-shell shell listPlugins 2>/dev/null || true)
  for id in overtake.notifications overtake.battery; do
    # on: only if the installer could build it; off: whenever it's enabled,
    # even if its folder has gone (or Omarchy's own would stay disabled)
    [[ $1 == off || -d $HOME/.config/omarchy/plugins/$id ]] || continue
    enabled=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .enabled' <<<"$listed" 2>/dev/null || true)
    if [[ $1 == on && $enabled != true ]]; then
      omarchy plugin enable "$id" >/dev/null 2>&1 && changed=1
    elif [[ $1 == off && $enabled == true ]]; then
      omarchy plugin disable "$id" >/dev/null 2>&1 && changed=1
    fi
  done
  (( changed )) || return 0
  omarchy-restart-shell >/dev/null 2>&1 || true
  local i
  for i in $(seq 20); do
    omarchy-shell shell ping >/dev/null 2>&1 && break
    sleep 0.25
  done
}

# on/off/toggle run one at a time (a double-tapped shortcut, or the menu and a
# shortcut together, would otherwise interleave and save the Overtake bar as
# "your" bar).
# A lock folder rather than flock: programs on/off start (the slideshow loop,
# the restarted shell) would inherit a lock file's handle and hold it forever.
# One left by a killed run is cleared after a minute.
MODE_LOCK="$STATE_DIR/.mode.lock.d"
mode_lock() {
  local i
  mkdir -p "$STATE_DIR"
  for i in $(seq 120); do
    if mkdir "$MODE_LOCK" 2>/dev/null; then
      trap 'rmdir "$MODE_LOCK" 2>/dev/null' EXIT
      return 0
    fi
    [[ -n $(find "$MODE_LOCK" -maxdepth 0 -mmin +1 2>/dev/null) ]] && rmdir "$MODE_LOCK" 2>/dev/null
    sleep 0.5
  done
  echo "overtake: another on/off is still running" >&2
  exit 1
}

turn_on() {
  [[ -f $FLAG ]] && { echo "Overtake Mode is already on"; return; }
  mkdir -p "$STATE_DIR"
  if jq -e '[.bar | .. | .id? // empty] | index("overtake.taskbar")' "$SHELL_JSON" >/dev/null 2>&1; then
    echo "the bar is already Overtake's; keeping the saved Omarchy bar" >&2
  else
    jq '.bar' "$SHELL_JSON" >"$SAVED_BAR"
  fi
  readlink -f "$CURRENT_BG" >"$SAVED_BG" 2>/dev/null || true
  # Keep the user's own battery widget if their Omarchy bar has a custom one
  # (a clone of omarchy.power), and the taskbar's settings (pinned apps) from
  # last time.
  local bar power
  power=$(jq -r '[.. | .id? // empty | select(test("\\.power$"))][0] // "omarchy.power"' "$SAVED_BAR")
  bar=$(jq --arg p "$power" '(.layout.right[] | select(.id == "omarchy.power") | .id) = $p' <<<"$WINDOWS_BAR")
  # A patched widget the installer had to skip: use Omarchy's own.
  local widget
  for widget in workspaces bluetooth audio; do
    [[ -d $HOME/.config/omarchy/plugins/overtake.$widget ]] && continue
    bar=$(jq --arg from "overtake.$widget" --arg to "omarchy.$widget" \
      '(.. | objects | select(.id? == $from) | .id) = $to | if .centerAnchor == $from then .centerAnchor = $to else . end' <<<"$bar")
  done
  # (pins kept by an uninstall wait in ~/.config/overtake)
  [[ -s $TASKBAR_SETTINGS || ! -s $HOME/.config/overtake/taskbar-settings.json ]] || cp "$HOME/.config/overtake/taskbar-settings.json" "$TASKBAR_SETTINGS"
  [[ -s $TASKBAR_SETTINGS ]] && bar=$(jq --slurpfile t "$TASKBAR_SETTINGS" '.layout.left = [$t[0]]' <<<"$bar")
  set_bar "$bar"
  add_bar_size
  hyprctl clients -j | jq -c '[.[] | select(.workspace.id > 0 and .floating) | .address]' >"$KEEP_FLOATING" 2>/dev/null || true
  touch "$FLAG" "$STATE_DIR/snap-request"
  # a theme's animated wallpaper stays; otherwise the slideshow's picture
  live_wallpaper_showing || refresh_wallpaper
  start_slideshow
  float_all
  # Back to their sections and places from last time, once the bar has moved.
  setsid sh -c 'sleep 2; overtake relayout all' </dev/null >/dev/null 2>&1 &
  # GTK apps (Files etc.) drop their own close button; Overtake Mode's title bar has one.
  gsettings get org.gnome.desktop.wm.preferences button-layout >"$SAVED_GTK_BUTTONS" 2>/dev/null || true
  gsettings set org.gnome.desktop.wm.preferences button-layout 'appmenu:' 2>/dev/null || true
  hyprctl reload >/dev/null
  notify $'\uf0ec' "Overtake Mode on (Super+Ctrl+Shift+W to switch back)"
}

turn_off() {
  [[ -f $FLAG ]] || { echo "Overtake Mode is already off"; return; }
  jq '[.bar.layout[][]? | select(.id == "overtake.taskbar")][0] // empty' "$SHELL_JSON" >"$TASKBAR_SETTINGS.tmp" \
    && [[ -s $TASKBAR_SETTINGS.tmp ]] && mv "$TASKBAR_SETTINGS.tmp" "$TASKBAR_SETTINGS" || rm -f "$TASKBAR_SETTINGS.tmp"
  if [[ -s $SAVED_BAR ]]; then
    set_bar "$(cat "$SAVED_BAR")"
  else
    # no saved bar (state removed?): fall back to Omarchy's default one
    set_bar "$(jq '.bar' "${OMARCHY_PATH:-/usr/share/omarchy}/config/omarchy/shell.json")"
    notify $'\uf071' "Overtake couldn't find your saved bar, so Omarchy's default bar is back"
  fi
  remove_bar_size
  rm -f "$FLAG" "$DESKTOP_RETURN"
  restore_all
  tile_all
  if [[ -s $SAVED_GTK_BUTTONS ]]; then
    gsettings set org.gnome.desktop.wm.preferences button-layout "$(tr -d "'" <"$SAVED_GTK_BUTTONS")" 2>/dev/null || true
    rm -f "$SAVED_GTK_BUTTONS"
  fi
  stop_slideshow
  # your wallpaper back, if the slideshow replaced it (not if you've picked
  # another one, or a theme's animated wallpaper never left)
  if [[ -s $SAVED_BG && -f $(<"$SAVED_BG") && $(readlink -f "$CURRENT_BG") == "$SLIDESHOW_DIR"/* ]]; then
    omarchy-theme-bg-set "$(<"$SAVED_BG")" >/dev/null 2>&1 || true
  fi
  hyprctl reload >/dev/null
  notify $'\uf0ec' "Overtake Mode off"
}

# Window controls. Minimized windows wait on the hidden special:minimized
# workspace; minimized.json remembers where each one came from.
window_address() {
  if [[ -n ${1:-} ]]; then echo "$1"; else hyprctl activewindow -j | jq -r '.address // empty'; fi
}

window_workspace() {
  hyprctl clients -j | jq -r --arg a "$1" '.[] | select(.address == $a) | .workspace.name'
}

minimize_window() {
  local addr ws
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] || return 0
  ws=$(window_workspace "$addr")
  [[ -n $ws && $ws != special:* ]] || return 0
  json_set "$MINIMIZED" '.[$a] = $w' --arg a "$addr" --arg w "$ws"
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:minimized\", follow = false, window = \"address:$addr\" })" >/dev/null
}

# $2 = "follow" to switch to the window's workspace and focus it.
restore_window() {
  local addr=$1 follow=${2:-follow} ws=""
  # Back to the workspace it was minimized from (or, failing that, the last
  # one the layout record saw it on), not the one being looked at.
  [[ -s $MINIMIZED ]] && ws=$(jq -r --arg a "$addr" '.[$a] // empty' "$MINIMIZED")
  [[ -n $ws || ! -s $LAYOUT ]] || ws=$(jq -r --arg a "$addr" '.[$a].ws // empty' "$LAYOUT")
  [[ -n $ws ]] || ws=$(hyprctl activeworkspace -j | jq -r '.name')
  if [[ $follow == follow ]]; then
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = true, window = \"address:$addr\" })" >/dev/null
    focus_raise "$addr"
  else
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, window = \"address:$addr\" })" >/dev/null
  fi
  [[ -s $MINIMIZED ]] && json_set "$MINIMIZED" 'del(.[$a])' --arg a "$addr"
  bring_into_view "$addr"
}

# A floating window keeps its position when a screen goes away (closing the
# lid, undocking), so it can end up where no screen shows it. Move such a
# window to the middle of its monitor, shrunk to fit if it's too big.
# Room for the title bar: a floating window whose top is too close to the top
# of its screen (one that opens full height, like Tensaku) moves down so the
# title bar sits above it instead of over its own toolbar, and is shortened
# if it would then run past the bottom.
make_room() {
  local addr=$1 info x y w h top bottom want newh
  info=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  [[ -n $info && $(jq -r '.floating and .fullscreen == 0' <<<"$info") == true ]] || return 0
  read -r top bottom < <(hyprctl monitors -j | jq -r --argjson id "$(jq .monitor <<<"$info")" \
    '.[] | select(.id == $id) | "\(.y + .reserved[1]) \(.y + (.height / .scale | floor) - .reserved[3])"')
  read -r x y w h < <(jq -r '.at + .size | map(floor) | join(" ")' <<<"$info")
  want=$((top + SNAP_TITLE_BAR))
  (( y < want )) || return 0
  newh=$h
  (( want + h > bottom )) && newh=$((bottom - want))
  mark_arranging
  (( newh != h )) && hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $newh, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $want, relative = false, window = \"address:$addr\" })" >/dev/null
}

bring_into_view() {
  local addr=$1 info monitors
  info=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  [[ -n $info ]] || return 0
  [[ $(jq -r '.floating and .fullscreen == 0 and (.workspace.name | startswith("special:") | not)' <<<"$info") == true ]] || return 0
  monitors=$(hyprctl monitors -j)
  # Visible enough: at least 120x48 of it on some screen.
  jq -e --argjson w "$info" 'any(.[];
      ([$w.at[0] + $w.size[0], .x + .width / .scale] | min) - ([$w.at[0], .x] | max) >= 120 and
      ([$w.at[1] + $w.size[1], .y + .height / .scale] | min) - ([$w.at[1], .y] | max) >= 48)' \
    <<<"$monitors" >/dev/null && return 0

  local mx my mw mh rl rt rr rb
  read -r mx my mw mh rl rt rr rb < <(jq -r --argjson id "$(jq .monitor <<<"$info")" \
    '(map(select(.id == $id)) + map(select(.focused)) + .)[0]
     | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor) \(.reserved | join(" "))"' <<<"$monitors")
  local uw=$((mw - rl - rr)) uh=$((mh - rt - rb - SNAP_TITLE_BAR))
  local w h
  w=$(jq .size[0] <<<"$info") h=$(jq .size[1] <<<"$info")
  (( w > uw * 9 / 10 )) && w=$((uw * 9 / 10))
  (( h > uh * 9 / 10 )) && h=$((uh * 9 / 10))
  local x=$((mx + rl + (uw - w) / 2)) y=$((my + rt + SNAP_TITLE_BAR + (uh - h) / 2))
  hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$addr\" })" >/dev/null
}

# Screens coming and going (dock, lid) leave floating windows at their old
# absolute positions. `remember` (run every few seconds by the taskbar plugin)
# records each window's place as fractions of its screen's usable area;
# `relayout` (run after a screen change) puts snapped windows back in their
# zone and the rest at the same fractions of the screen they're on now.
USABLE_JQ='def usable: {name, x: (.x + .reserved[0]), y: (.y + .reserved[1]),
  w: ((.width / .scale | floor) - .reserved[0] - .reserved[2]),
  h: ((.height / .scale | floor) - .reserved[1] - .reserved[3])};'

remember_layout() {
  local clients monitors
  clients=$(hyprctl clients -j) monitors=$(hyprctl monitors -j)
  # Only windows whose centre is on their own screen (skips ones a screen change
  # has just stranded), merged over the old records; closed windows dropped.
  json_set "$LAYOUT" "$USABLE_JQ"'
    ($monitors | map({key: (.id | tostring), value: usable}) | from_entries) as $m
    | ([$clients[] | .address]) as $live
    | (with_entries(select(.key as $k | $live | index($k))))
      + ([$clients[] | select(.floating and .fullscreen == 0 and .workspace.id > 0)
          | . as $c | $m[(.monitor | tostring)] as $u | select($u != null)
          | (.at[0] + .size[0] / 2) as $cx | (.at[1] + .size[1] / 2) as $cy
          | select($cx >= $u.x and $cx < $u.x + $u.w and $cy >= $u.y and $cy < $u.y + $u.h)
          | {key: .address, value: {mon: $u.name, uw: $u.w, uh: $u.h, ws: $c.workspace.name,
              fx: (($c.at[0] - $u.x) / $u.w), fy: (($c.at[1] - $u.y) / $u.h),
              fw: ($c.size[0] / $u.w), fh: ($c.size[1] / $u.h)}}] | from_entries)
  ' --argjson clients "$clients" --argjson monitors "$monitors"
}

# relayout [all]: "all" puts every recorded window back (used by `on`, when
# windows come back from tiling), not just the ones on a changed screen.
relayout() {
  local clients monitors addr zone cmds all=false
  mark_arranging
  [[ ${1:-} == all ]] && all=true
  clients=$(hyprctl clients -j) monitors=$(hyprctl monitors -j)
  # Snapped windows: back into their zone on whatever screen they're on now.
  if [[ -s $ZONES ]]; then
    while read -r addr zone; do
      [[ -n $addr ]] && SNAP_NO_FOCUS=1 snap_window "$zone" "$addr"
    done < <(jq -r --argjson clients "$clients" '
      to_entries[] | .key as $a | select(any($clients[]; .address == $a and .floating and .fullscreen == 0 and .workspace.id > 0))
      | "\(.key) \(.value.zone)"' "$ZONES")
  fi
  # Everything else: same fractions of its current screen, if that screen is a
  # different one (or a different size) from when it was recorded. Any window
  # is then kept inside its screen (shrunk if it's bigger).
  [[ -s $LAYOUT ]] || echo '{}' >"$LAYOUT"
  cmds=$(jq -r --argjson all "$all" --argjson clients "$clients" --argjson monitors "$monitors" --slurpfile zones <(cat "$ZONES" 2>/dev/null || echo '{}') "$USABLE_JQ"'
    ($monitors | map({key: (.id | tostring), value: usable}) | from_entries) as $m
    | . as $rec
    | $clients[] | select(.floating and .fullscreen == 0 and .workspace.id > 0)
    | select(($zones[0] // {})[.address] == null)
    | $m[(.monitor | tostring)] as $u | select($u != null)
    | ($rec[.address] // null) as $r
    | ($r != null and ($all or $r.mon != $u.name or $r.uw != $u.w or $r.uh != $u.h)) as $moved
    | (if $moved then [$r.fx * $u.w + $u.x, $r.fy * $u.h + $u.y, $r.fw * $u.w, $r.fh * $u.h]
       else [.at[0], .at[1], .size[0], .size[1]] end | map(floor)) as $g
    | ([[$g[2], $u.w] | min, 200] | max) as $w | ([[$g[3], $u.h] | min, 120] | max) as $h
    | ([[$g[0], $u.x + $u.w - $w] | min, $u.x] | max) as $x | ([[$g[1], $u.y + $u.h - $h] | min, $u.y] | max) as $y
    | select($moved or $w != .size[0] or $h != .size[1] or $x != .at[0] or $y != .at[1])
    | "dispatch hl.dsp.window.resize({ x = \($w), y = \($h), relative = false, window = \"address:\(.address)\" }) ; " +
      "dispatch hl.dsp.window.move({ x = \($x), y = \($y), relative = false, window = \"address:\(.address)\" })"
  ' "$LAYOUT" | paste -sd ';')
  [[ -z $cmds ]] || hyprctl --batch "$cmds" >/dev/null
  rescue_all
  unstick_workspaces
  remember_layout
}

# A screen leaving mid-animation (lid closing as the dock comes up) can freeze a
# workspace's slide part-way: its windows are drawn a whole screen-width off to
# one side while their title bars stay put. Hyprland lists that as "workspace
# offset" long after any real animation has ended; leaving the workspace and
# coming back redraws it in place.
unstick_workspaces() {
  local ws
  for ws in $(hyprctl monitors | awk '
      /^Monitor /                      { ws = "" }
      /^\tactive workspace: /          { ws = $3 }
      /^\tsolitaryBlockedBy: .*workspace offset/ && ws != "" { print ws }'); do
    hyprctl --batch "eval hl.config({ cursor = { no_warps = true } }) ; dispatch hl.dsp.focus({ workspace = \"empty\" }) ; dispatch hl.dsp.focus({ workspace = \"$ws\" }) ; eval hl.config({ cursor = { no_warps = false } })" >/dev/null
  done
}

rescue_all() {
  local addr
  mark_arranging
  for addr in $(hyprctl clients -j | jq -r '.[] | select(.floating and (.workspace.name | startswith("special:") | not)) | .address'); do
    bring_into_view "$addr"
  done
}

# Taskbar click or title-bar tab: bring the window back on screen if needed,
# then focus it (switching to its workspace).
# Raise it too: focus alone leaves a floating window under the one covering it,
# and focus-follows-mouse then hands focus straight back to the top one.
show_window() {
  bring_into_view "$1"
  focus_raise "$1"
}

# Focus and raise without moving the mouse (Hyprland normally warps the cursor
# to the window it focuses; a click shouldn't move the pointer).
focus_raise() {
  hyprctl --batch "eval hl.config({ cursor = { no_warps = true } }) ; dispatch hl.dsp.focus({ window = \"address:$1\" }) ; dispatch hl.dsp.window.bring_to_top() ; eval hl.config({ cursor = { no_warps = false } })" >/dev/null
}

# Hyprland shows a special workspace when something focuses a window on it
# (focus returning to a minimized window after a menu closes, an app asking to
# be activated). Minimized windows have no title bar and can't be minimized
# again from there, so hide it straight away; the taskbar restores them.
hide_minimized() {
  local mon
  for mon in $(hyprctl monitors -j | jq -r '.[] | select(.specialWorkspace.name == "special:minimized") | .name'); do
    hyprctl --batch "dispatch hl.dsp.focus({ monitor = \"$mon\" }) ; dispatch hl.dsp.workspace.toggle_special(\"minimized\")" >/dev/null
  done
}

# Go to an app's window where it lives (the notification center's click):
# matched by class like omarchy-hyprland-focus-app, the most recently used
# window first. A minimized one is restored to the workspace it came from and
# followed there; any other is reached by switching to its workspace.
focus_app() {
  local info addr ws
  info=$(hyprctl clients -j | jq -c --arg p "$1" '
    ($p | ascii_downcase) as $q
    | sort_by(.focusHistoryID)
    | first(.[] | select([(.class // ""), (.initialClass // "")] | any(ascii_downcase | contains($q)))) // empty')
  [[ -n $info ]] || return 1
  addr=$(jq -r .address <<<"$info") ws=$(jq -r .workspace.name <<<"$info")
  if [[ $ws == special:minimized ]]; then
    restore_window "$addr" follow
  else
    [[ $ws == special:* ]] || hyprctl dispatch "hl.dsp.focus({ workspace = \"$ws\" })" >/dev/null
    focus_raise "$addr"
  fi
}

# A link clicked in another app (Omarchy's link handler, omarchy-browser.desktop,
# runs this once Overtake is installed). The browser would put it in the window
# used last, which may be on another workspace or minimized, and focusing that
# window pulls you away from where you clicked. Use the browser's window on this
# workspace instead, or open a new window here.
open_url() {
  [[ -f $FLAG && $# -gt 0 && " $* " != *" --private "* ]] || exec omarchy-launch-browser "$@"
  local entry browser ws addr args
  entry=$(omarchy-cmd-default-browser 2>/dev/null || true)
  browser=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/"$entry" 2>/dev/null | head -1 || true)
  [[ -n $entry && -n $browser ]] || exec omarchy-launch-browser "$@"
  ws=$(hyprctl activeworkspace -j | jq -r .name)
  addr=$(hyprctl clients -j | jq -r --arg p "^$(basename "$browser" -stable)" --arg ws "$ws" '
    sort_by(.focusHistoryID)
    | first(.[] | select(.workspace.name == $ws and ((.class // "") | test($p; "i")))).address // empty')
  if [[ -n $addr ]]; then
    # focused first, so the browser counts it as its last used window
    focus_raise "$addr"
    sleep 0.15
    args=("$@")
  else
    args=(--new-window "$@")
  fi
  omarchy-cmd-browser-handoff "$browser" "${args[@]}" 2>/dev/null ||
    systemd-run --user --quiet --collect --unit="overtake-browser-$(date +%s%N)" \
      --property=StandardOutput=null --property=StandardError=null \
      uwsm-app -- "$browser" "${args[@]}"
}

# A notification clicked in the notification center that carries no action of
# its own: open a file the message names (quoted paths first, as they may
# hold spaces, then unquoted ones up to a space); else go to the app's window
# where it lives; else launch the app from its desktop entry (which also
# reopens one closed to the tray). Exit 1 when none of that is possible.
notification_open() {
  local app=$1 icon=$2 body=$3 f name d entry
  while IFS= read -r f; do
    f=${f%[.,;:)]}
    # only an ordinary file or folder in your home folder, never a launcher or
    # a program (the text comes from whichever app sent the notification)
    f=$(realpath -e -- "$f" 2>/dev/null) || continue
    [[ $f == "$HOME"/* && ! -L $f && $f != *.desktop ]] || continue
    [[ -d $f || ( -f $f && ! -x $f ) ]] || continue
    xdg-open "$f" >/dev/null 2>&1 &
    return 0
  done < <({ grep -oE "'/[^']+'" <<<"$body" | tr -d "'"; grep -oE '"/[^"]+"' <<<"$body" | tr -d '"'
             grep -oE "/[^'\"<> ]+" <<<"$body"; } || true)
  [[ -n $app ]] && focus_app "$app" && return 0
  for name in "$app" "$icon"; do
    [[ -n $name ]] || continue
    for d in "$HOME/.local/share/applications" /usr/share/applications; do
      entry=$(find "$d" -maxdepth 1 -iname "$name.desktop" -print -quit 2>/dev/null || true)
      [[ -n $entry ]] && { uwsm-app -- gtk-launch "$(basename "$entry")" >/dev/null 2>&1 & return 0; }
    done
  done
  return 1
}

# Clicking empty desktop: minimize every window on the workspace that screen
# shows (the focused screen's when none is given).
minimize_all() {
  local ws addr
  if [[ -n ${1:-} ]]; then
    ws=$(hyprctl monitors -j | jq -r --arg m "$1" '.[] | select(.name == $m) | .activeWorkspace.name')
  else
    ws=$(hyprctl activeworkspace -j | jq -r '.name')
  fi
  [[ -n $ws && $ws != special:* ]] || return 0
  for addr in $(hyprctl clients -j | jq -r --arg w "$ws" '.[] | select(.workspace.name == $w) | .address'); do
    minimize_window "$addr"
  done
}

# Screensaver settings, using Omarchy's own pieces: the screensaver-off toggle,
# the idle timeouts in shell.json (seconds; 0 = never), and the art in
# ~/.config/omarchy/branding/screensaver.txt.
SCREENSAVER_ART="$HOME/.config/omarchy/branding/screensaver.txt"
screensaver_cmd() {
  case "${1:-}" in
    on) omarchy-toggle-enabled screensaver-off && omarchy-toggle screensaver-off >/dev/null; true ;;
    off) omarchy-toggle-enabled screensaver-off || omarchy-toggle screensaver-off >/dev/null; true ;;
    enabled) ! omarchy-toggle-enabled screensaver-off ;;
    start|lock)
      local key=screensaver tmp
      [[ $1 == lock ]] && key=lock
      if [[ -z ${2:-} ]]; then jq -r --arg k "$key" '.idle[$k] // (if $k == "lock" then 300 else 150 end)' "$SHELL_JSON"; return; fi
      [[ $2 =~ ^[0-9]+$ ]] || { echo "seconds, please" >&2; return 1; }
      tmp=$(mktemp "$SHELL_JSON.XXXXXX")
      jq --arg k "$key" --argjson v "$2" '.idle[$k] = $v' "$SHELL_JSON" >"$tmp" && mv "$tmp" "$SHELL_JSON"
      omarchy-shell shell reloadConfig >/dev/null 2>&1 || true ;;
    show)
      local omarchy="${OMARCHY_PATH:-/usr/share/omarchy}"
      case "${2:-}" in
        omarchy) cp "$omarchy/logo.txt" "$SCREENSAVER_ART" ;;
        text) omarchy-launch-editor "$SCREENSAVER_ART" >/dev/null 2>&1; return ;;
        image) omarchy-branding-screensaver image; return ;;
        wallpaper)
          # The art is drawn in dots on black: a dark (night) wallpaper is
          # flipped first so its lights become the dots, a bright one keeps its
          # dark shapes as the dots.
          local bg tmp mean
          bg=$(readlink -f "$CURRENT_BG")
          tmp=$(mktemp --suffix=.png)
          mean=$(magick "$bg" -colorspace gray -format '%[fx:mean < 0.4 ? 1 : 0]' info: 2>/dev/null || echo 0)
          if [[ $mean == 1 ]]; then magick "$bg" -negate "$tmp"; else cp "$bg" "$tmp"; fi
          omarchy-transcode-ascii "$tmp" "$SCREENSAVER_ART" >/dev/null || { rm -f "$tmp"; return 1; }
          rm -f "$tmp" ;;
        *) echo "show omarchy|text|image|wallpaper" >&2; return 1 ;;
      esac
      omarchy-launch-screensaver force >/dev/null 2>&1 & ;;
    showing)
      if cmp -s "$SCREENSAVER_ART" "${OMARCHY_PATH:-/usr/share/omarchy}/logo.txt"; then echo "Omarchy logo"; else echo "Your own"; fi ;;
    preview) omarchy-launch-screensaver force >/dev/null 2>&1 & ;;
    *) echo "overtake screensaver on|off|enabled|start [s]|lock [s]|show <omarchy|text|image|wallpaper>|showing|preview" >&2; return 1 ;;
  esac
}

restore_all() {
  local addr
  for addr in $(hyprctl clients -j | jq -r '.[] | select(.workspace.name == "special:minimized") | .address'); do
    restore_window "$addr" stay
  done
}

maximize_window() {
  local addr
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] && hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"maximized\", window = \"address:$addr\" })" >/dev/null
}

close_window() {
  local addr
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] && hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null
}

# ---------- Floating and snap layouts ----------
# Several overtake processes can write the same state file at once (quick
# clicks, the taskbar's periodic `remember`), so writes take a lock and their
# own temp file, and an empty result never replaces the file.
# A browser window's page address, to the clipboard. Nothing outside the
# browser can ask it for the page it shows, but it keeps every page it visits
# (address and title) in its History database, and the window's title is the
# page's title: so the newest visit with that title. Chromium-family browsers
# (Omarchy's web apps run in one).
copy_url() {
  local addr=$1 class title dir url
  read -r class < <(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address == $a) | .class')
  title=$(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address == $a) | .title')
  case $class in
    chromium | chrome-*) dir="$HOME/.config/chromium" ;;
    google-chrome*) dir="$HOME/.config/google-chrome" ;;
    brave*) dir="$HOME/.config/BraveSoftware/Brave-Browser" ;;
    *) notify $'\uf0c5' "Copy URL works with Chromium, Chrome, Brave and Omarchy's web apps"; return 0 ;;
  esac
  url=$(python3 -I - "$dir" "$title" <<'PY'
import glob, os, shutil, sqlite3, sys, tempfile
root, title = sys.argv[1], sys.argv[2]
for suffix in (" - Chromium", " - Google Chrome", " - Brave"):
    if title.endswith(suffix): title = title[: -len(suffix)]
best = None
with tempfile.TemporaryDirectory() as tmp:
    for i, db in enumerate(glob.glob(os.path.join(root, "*", "History"))):
        copy = os.path.join(tmp, str(i))
        shutil.copy(db, copy)   # the browser keeps the database locked
        try:
            row = sqlite3.connect(copy).execute(
                "select url, last_visit_time from urls where title = ? order by last_visit_time desc limit 1", (title,)).fetchone()
        except sqlite3.Error:
            continue
        if row and (best is None or row[1] > best[1]): best = row
print(best[0] if best else "")
PY
)
  if [[ -n $url ]]; then
    printf '%s' "$url" | wl-copy
    notify $'\uf0c5' "Copied $url"
  else
    notify $'\uf0c5' "Couldn't find this page's address yet (try again in a few seconds)"
  fi
}

# The taskbar to the start of a bar section, the way Omarchy's own bar
# commands edit the layout: shell.json, then a config reload.
taskbar_position() {
  local config="$HOME/.config/omarchy/shell.json"
  [[ $1 == left || $1 == center ]] || { echo "overtake: taskbar-position takes left or center" >&2; return 1; }
  [[ -s $config ]] || return 0
  json_set "$config" '
    ([.bar.layout // {} | to_entries[] | .value | arrays | .[] | select(.id? == "overtake.taskbar")][0] // {id: "overtake.taskbar"}) as $entry
    | .bar.layout |= ((. // {}) | with_entries(if (.value | type) == "array" then .value |= map(select(.id? != "overtake.taskbar")) else . end))
    | .bar.layout[$to] = [$entry] + (.bar.layout[$to] // [])
  ' --arg to "$1"
  omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
}

json_set() {  # json_set <file> <jq filter> [jq args...]
  local file=$1 filter=$2
  shift 2
  mkdir -p "$STATE_DIR"
  (
    flock 9
    [[ -s $file ]] || echo '{}' >"$file"
    tmp=$(mktemp "$file.XXXXXX")
    if jq "$@" "$filter" "$file" >"$tmp" && [[ -s $tmp ]]; then mv "$tmp" "$file"; else rm -f "$tmp"; fi
  ) 9>"$STATE_DIR/.lock"
}

float_all() {
  local addr
  mark_arranging
  for addr in $(hyprctl clients -j | jq -r '.[] | select(.workspace.id > 0 and .floating == false) | .address'); do
    hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"address:$addr\" })" >/dev/null || true
  done
}

# Back to tiling for `off`: every floating window on a normal workspace except
# the ones that were already floating before `on` (dialogs, pickers, ones you
# floated yourself). Windows opened while the mode was on float by its rule,
# so a list of "windows the mode floated" would miss them.
tile_all() {
  local addr keep='[]'
  [[ -s $KEEP_FLOATING ]] && keep=$(<"$KEEP_FLOATING")
  for addr in $(hyprctl clients -j | jq -r --argjson keep "$keep" \
      '.[] | select(.workspace.id > 0 and .floating and (.address as $a | $keep | index($a) | not)) | .address'); do
    hyprctl dispatch "hl.dsp.window.float({ action = \"disable\", window = \"address:$addr\" })" >/dev/null 2>&1 || true
  done
  # Zones are kept: `on` puts snapped windows back in them.
  rm -f "$KEEP_FLOATING"
}

# Overtake is about to move windows itself. The title-bar plugin watches the
# focused window for drags an app makes on its own; this stamp tells it to
# ignore movement for a moment, so our own arranging isn't taken for a drag
# out of a zone (which would unsnap it).
mark_arranging() {
  mkdir -p "$STATE_DIR"
  date +%s%N >"$STATE_DIR/arranging"
}

snap_window() {
  local zone=$1 addr info ws mon count
  addr=$(window_address "${2:-}")
  [[ -n $addr ]] || return 0
  info=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  [[ -n $info ]] || return 0
  ws=$(jq -r .workspace.name <<<"$info")
  mon=$(jq -r .monitor <<<"$info")
  mkdir -p "$STATE_DIR"

  # Forget windows that have closed, then respect the per-zone stack limit.
  json_set "$ZONES" 'with_entries(select(.key as $k | $live | index($k)))' \
    --argjson live "$(hyprctl clients -j | jq '[.[].address]')"
  count=$(jq --arg ws "$ws" --arg z "$zone" --arg a "$addr" \
    '[to_entries[] | select(.value.ws == $ws and .value.zone == $z and .key != $a)] | length' "$ZONES")
  if (( count >= SNAP_STACK_MAX )); then
    notify $'' "That spot already has $SNAP_STACK_MAX windows"
    return 0
  fi

  # Usable area of the window's monitor (logical pixels, minus the taskbar).
  local mx my mw mh rl rt rr rb
  read -r mx my mw mh rl rt rr rb < <(hyprctl monitors -j | jq -r --argjson id "$mon" \
    '.[] | select(.id == $id) | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor) \(.reserved | join(" "))"')
  local ux=$((mx + rl + SNAP_GAP)) uy=$((my + rt + SNAP_GAP))
  local uw=$((mw - rl - rr - 2 * SNAP_GAP)) uh=$((mh - rt - rb - 2 * SNAP_GAP))
  local hw=$(((uw - SNAP_GAP) / 2)) hh=$(((uh - SNAP_GAP) / 2))
  local x y w h
  case "$zone" in
    left) x=$ux y=$uy w=$hw h=$uh ;;
    right) x=$((ux + hw + SNAP_GAP)) y=$uy w=$hw h=$uh ;;
    top-left) x=$ux y=$uy w=$hw h=$hh ;;
    top-right) x=$((ux + hw + SNAP_GAP)) y=$uy w=$hw h=$hh ;;
    bottom-left) x=$ux y=$((uy + hh + SNAP_GAP)) w=$hw h=$hh ;;
    bottom-right) x=$((ux + hw + SNAP_GAP)) y=$((uy + hh + SNAP_GAP)) w=$hw h=$hh ;;
    full) x=$ux y=$uy w=$uw h=$uh ;;
    *) echo "Unknown zone: $zone" >&2; return 1 ;;
  esac
  y=$((y + SNAP_TITLE_BAR))
  h=$((h - SNAP_TITLE_BAR))
  mark_arranging

  [[ $(jq -r .fullscreen <<<"$info") != 0 ]] && hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"maximized\", window = \"address:$addr\" })" >/dev/null
  [[ $(jq -r .floating <<<"$info") == true ]] || hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$addr\" })" >/dev/null
  [[ -n ${SNAP_NO_FOCUS:-} ]] || hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null

  # Remember the pre-snap size (only the first time) so dragging it out restores it.
  json_set "$ZONES" '.[$a] = {ws: $ws, zone: $z, restore: (.[$a].restore // $size)}' \
    --arg a "$addr" --arg ws "$ws" --arg z "$zone" --argjson size "$(jq -c .size <<<"$info")"
}

# Dragged out of its zone: back to the pre-snap size (at most 70% of the
# screen), keeping its top-left where it was dropped.
unsnap_window() {
  local addr=$1 size info w h x y mw mh
  [[ -s $ZONES ]] || return 0
  size=$(jq -r --arg a "$addr" '.[$a].restore // empty | "\(.[0]) \(.[1])"' "$ZONES")
  json_set "$ZONES" 'del(.[$a])' --arg a "$addr"
  [[ -n $size ]] || return 0
  info=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  [[ -n $info ]] || return 0
  mark_arranging
  read -r x y < <(jq -r '"\(.at[0]) \(.at[1])"' <<<"$info")
  read -r mw mh < <(hyprctl monitors -j | jq -r --argjson id "$(jq .monitor <<<"$info")" \
    '.[] | select(.id == $id) | "\((.width / .scale) | floor) \((.height / .scale) | floor)"')
  w=${size% *} h=${size#* }
  (( w > mw * 7 / 10 )) && w=$((mw * 7 / 10))
  (( h > mh * 7 / 10 )) && h=$((mh * 7 / 10))
  hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$addr\" })" >/dev/null
}

show_desktop() {
  local current windows
  current=$(hyprctl activeworkspace -j | jq -r '.id')
  windows=$(hyprctl activeworkspace -j | jq -r '.windows')
  if (( windows > 0 )); then
    mkdir -p "$STATE_DIR"
    echo "$current" >"$DESKTOP_RETURN"
    hyprctl dispatch 'hl.dsp.focus({ workspace = "empty" })' >/dev/null
  elif [[ -f $DESKTOP_RETURN ]]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = \"$(cat "$DESKTOP_RETURN")\" })" >/dev/null
    rm -f "$DESKTOP_RETURN"
  fi
}

# The theme picker by folder (Omarchy menu > Style > Theme): Omarchy's own
# themes, the ones you added (~/.config/omarchy/themes that aren't Omarchy's),
# or all of them. Same picker and output as omarchy-theme-switcher.
theme_picker() {
  local which=${1:-all}
  [[ $which == omarchy || $which == custom || $which == all ]] || { echo "theme-picker takes omarchy, custom or all" >&2; return 1; }
  shopt -s nullglob
  [[ $which == all ]] && exec omarchy-theme-switcher
  local builtin="${OMARCHY_PATH:-/usr/share/omarchy}/themes" user="$HOME/.config/omarchy/themes"
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/overtake/theme-picker/$which"
  local dirs=() dir name preview selected="" current
  if [[ $which == omarchy ]]; then
    for dir in "$builtin"/*/; do dirs+=("${dir%/}"); done
  else
    for dir in "$user"/*/; do
      [[ -d $builtin/$(basename "$dir") ]] || dirs+=("${dir%/}")
    done
  fi
  rm -rf "$cache"
  mkdir -p "$cache"
  current=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)
  for dir in "${dirs[@]}"; do
    name=$(basename "$dir")
    preview=$(find -L "$dir" -maxdepth 1 -type f -iname 'preview.*' 2>/dev/null | sort | head -1 || true)
    [[ -n $preview ]] || preview=$(find -L "$dir/backgrounds" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort | head -1 || true)
    [[ -n $preview ]] || continue
    ln -s "$preview" "$cache/$name.${preview##*.}"
    [[ $name == "$current" ]] && selected="$cache/$name.${preview##*.}"
  done
  exec omarchy-menu-images --print-name --show-labels --filterable --lazy-thumbnails --selected "$selected" "$cache"
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-help}" in
  help|-h|--help) usage ;;
  on) mode_lock; turn_on ;;
  off) mode_lock; turn_off ;;
  toggle) mode_lock; if [[ -f $FLAG ]]; then turn_off; else turn_on; fi ;;
  status) [[ -f $FLAG ]] && echo on || echo off ;;
  show-desktop) show_desktop ;;
  theme-picker) theme_picker "${2:-all}" ;;
  next-wallpaper)
    if [[ ! -f $FLAG ]]; then :
    elif [[ $(wallpaper_mode) == day-night ]]; then notify $'' "Day & Night wallpaper follows the sun (switch to Rotate in the Overtake Mode menu)"
    else next_wallpaper; fi ;;
  wallpaper-mode) if [[ -n ${2:-} ]]; then set_wallpaper_mode "$2"; else wallpaper_mode; fi ;;
  resume) if [[ -f $FLAG ]]; then [[ $(wallpaper_mode) == day-night ]] && ! live_wallpaper_showing && apply_day_night; start_slideshow; float_all; rescue_all; fi ;;
  minimize) minimize_window "${2:-}" ;;
  restore) [[ -n ${2:-} ]] && restore_window "$2" || true ;;
  restore-all) restore_all ;;
  minimize-all) minimize_all "${2:-}" ;;
  services) switch_services "${2:-on}" ;;   # internal: install/uninstall
  focus-app) [[ -n ${2:-} ]] && focus_app "$2" ;;
  notification-open) notification_open "${2:-}" "${3:-}" "${4:-}" ;;
  screensaver) shift; screensaver_cmd "$@" ;;
  hide-minimized) hide_minimized ;;
  show) [[ -n ${2:-} ]] && show_window "$2" || true ;;
  rescue) rescue_all ;;
  make-room) [[ -n ${2:-} ]] && make_room "$2" || true ;;
  remember) [[ -f $FLAG ]] && remember_layout || true ;;
  relayout) [[ -f $FLAG ]] && relayout "${2:-}" || true ;;
  float-all) [[ -f $FLAG ]] && float_all || true ;;
  maximize) maximize_window "${2:-}" ;;
  close) close_window "${2:-}" ;;
  snap) [[ -n ${2:-} ]] && snap_window "$2" "${3:-}" || true ;;
  unsnap) [[ -n ${2:-} ]] && unsnap_window "$2" || true ;;
  snap-layouts) mkdir -p "$STATE_DIR"; date +%s%N >"$STATE_DIR/snap-request" ;;
  taskbar-position) taskbar_position "${2:-}" ;;
  copy-url) [[ -n ${2:-} ]] && copy_url "$2" || true ;;
  open-url) shift; open_url "$@" ;;
  rename) [[ -n ${2:-} ]] && { show_window "$2"; mkdir -p "$STATE_DIR"; echo "$2 $(date +%s%N)" >"$STATE_DIR/rename-request"; } || true ;;
  start) mkdir -p "$STATE_DIR"; echo "${2:-start} $(date +%s%N)" >"$STATE_DIR/start-request" ;;
  settings) mkdir -p "$STATE_DIR"; echo "${2:-open} $(date +%s%N)" >"$STATE_DIR/settings-request" ;;
  slideshow-loop) slideshow_loop ;;   # internal: the slideshow's background loop
  *) echo "overtake: unknown command '$1' (overtake help lists them)" >&2; exit 1 ;;
esac
