#!/bin/bash
# Switch between Omarchy's own desktop and Overtake Mode's two: Classic (a
# taskbar and Start menu along the bottom, title bars, snap layouts) and Studio
# (a menu bar on top, a Dock, Spotlight), each with familiar shortcuts
# (~/.config/hypr/overtake*.lua) and its own theme and wallpaper.
#
#   overtake on|off|toggle|status
#   overtake cycle            # SUPER+CTRL+SHIFT+W: next mode (Omarchy -> Classic -> Studio -> Omarchy)
#   overtake style [classic|studio]  # pick or print the mode: Classic (taskbar, Start) or Studio (menu bar, Dock)
#   overtake studio-get|studio-set <dockSize|dockMagnify|dockAutohide> [value]  # Studio's Dock options (Settings)
#   overtake show-desktop     # SUPER+D: jump to an empty workspace and back
#   overtake bg-picker [cache|apply]  # the desktop's Change background: the theme's backgrounds plus Overtake's; prints the pick (apply: puts it up)
#   overtake next-wallpaper   # SUPER+CTRL+ALT+SPACE: next slideshow wallpaper
#   overtake wallpaper-mode [rotate|day-night]   # pick or print the slideshow mode
#   overtake minimize|maximize|close [address]  # active window when no address
#   overtake restore <address> [stay] | restore-all
#   overtake focus-app <name>      # go to an app's window on its own workspace (restoring it if minimized)
#   overtake notification-open        # a notification click without its own action: the app (on stdin), its window
#   overtake minimize-all [monitor]   # clicking the desktop: minimize this workspace's windows
#   overtake screensaver <on|off|enabled|start|lock|show|showing|preview> [...]  # Settings > Screensaver
#   overtake hide-minimized   # taskbar: hide the minimized windows' workspace if it gets shown
#   overtake show <address>   # taskbar click: bring on screen if needed, then focus
#   overtake float-all        # float any tiled window (floating ones always cover tiled ones)
#   overtake remember | relayout  # record window places; restore them after a screen change
#   overtake rescue           # move floating windows no screen shows back into view
#   overtake make-room <address>  # move a window down so its title bar fits above it
#   overtake snap <left|right|top-left|top-right|bottom-left|bottom-right|full|center> [address]
#   overtake unsnap <address> # back to the size it had before snapping (unsnap-active: the focused window)
#   overtake send <1-9> <address> [x y]  # drop on a workspace box: move the window there
#   overtake start [quick|all]  # Super+S / Super+X: open the Start menu, its quick-link menu, or All apps
#   overtake settings [page]  # Super+I: the Settings window (system, bluetooth, network, ...)
#   overtake snap-layouts     # SUPER+Z: show the snap layouts for the focused window
#   overtake uninstall [--purge] [--dry-run] [--yes]  # remove Overtake Mode (runs its uninstall.sh)
#   overtake build-copies [all|update]  # (re)build the patched copies of Omarchy's plugins from the installed Omarchy
#   overtake copies on|off    # (the installer) Overtake's notifications and battery copies on or off
#   overtake taskbar-position <left|center>  # right-click Start: where the taskbar sits on the bar
#   overtake copy-url <address>  # title bar menu: copy a browser window's page address
#   overtake rename [address]    # taskbar menu: bring a window up with its name ready to edit
#   overtake name <address|here> [-]  # name a window (shown in the taskbar and title bar) from one line on stdin; no - clears it
#                             # "here": the window this runs in
#   overtake fill-gap <address>  # a window opened: snap it into a spot snapped windows leave free
#   overtake ui <spotlight|apps|app-windows|switcher|switcher-back|switcher-commit|switcher-cancel|mission-control|force-quit|app-menu|control-center>
#                             # Studio: open one of its panels (Super+Space, Super+Tab, Ctrl+Up, ...)
#   overtake hide-app|hide-others|quit-app [address]  # Studio: Super+H, Super+Alt+H, Super+Q
#   overtake resume           # at login: check the patched copies still match Omarchy; restart the slideshow if the mode is on (and fix-bar)
#   overtake fix-bar          # put Overtake's workspaces/bluetooth/audio back if the bar has Omarchy's

set -euo pipefail

SHELL_JSON="$HOME/.config/omarchy/shell.json"
STATE_DIR="$HOME/.local/state/overtake"
# Overtake's folders are yours only, whichever command makes them first (and
# tightened at startup if they were left open).
for _dir in "$STATE_DIR" "$HOME/.config/overtake" "${XDG_CACHE_HOME:-$HOME/.cache}/overtake"; do
  if [[ ! -e $_dir ]]; then mkdir -p -m 700 "$_dir" 2>/dev/null || true
  elif [[ -d $_dir && ! -L $_dir && -O $_dir && $(stat -c %a "$_dir") != 700 ]]; then chmod 700 "$_dir" 2>/dev/null || true
  fi
done
unset _dir
FLAG="$STATE_DIR/enabled"
SAVED_BAR="$STATE_DIR/omarchy-bar.json"
DESKTOP_RETURN="$STATE_DIR/desktop-return"

# The look: Classic (bottom taskbar, Start) or Studio (top menu bar, Dock).
# Kept in your settings, so it survives turning the mode off and on.
STYLE_FILE="$HOME/.config/overtake/style"
style() {
  local value=classic
  [[ -s $STYLE_FILE ]] && value=$(<"$STYLE_FILE")
  [[ $value == studio ]] && echo studio || echo classic
}

# Each look has its own wallpapers (Day & Night uses the first two).
if [[ $(style) == studio ]]; then
  SLIDESHOW_DIR="$HOME/Pictures/overtake/studio"
else
  SLIDESHOW_DIR="$HOME/Pictures/overtake/slideshow"
fi
SLIDESHOW_MINUTES=15
CURRENT_BG="$HOME/.local/state/omarchy/current/background"
SAVED_BG="$STATE_DIR/omarchy-background"
SLIDE_SHOWN="$STATE_DIR/slide-shown"  # the picture the slideshow last put up
LOOKS_DIR="$STATE_DIR/looks"        # each mode's theme and wallpaper: <omarchy|classic|studio>.{theme,bg,picked}
CURRENT_THEME_NAME="$HOME/.local/state/omarchy/current/theme.name"
SLIDE_INDEX="$STATE_DIR/slide-index"
SLIDESHOW_PID="$STATE_DIR/slideshow.pid"
WALLPAPER_MODE_FILE="$STATE_DIR/wallpaper-mode"
MINIMIZED="$STATE_DIR/minimized.json"
LAYOUT="$STATE_DIR/layout.json"     # each floating window's place as fractions of its screen
ZONES="$STATE_DIR/zones.json"       # snapped windows: address -> {ws, zone, restore: [w, h]}
KEEP_FLOATING="$STATE_DIR/kept-floating.json"  # windows already floating before `on`; `off` tiles all the others
TILED="$STATE_DIR/tiled.json"       # tiled windows' places before `on`; `off` rebuilds those tiles
TASKBAR_SETTINGS="$STATE_DIR/taskbar-settings.json"  # taskbar pins etc., kept while the mode is off
SAVED_GTK_BUTTONS="$STATE_DIR/gtk-button-layout"  # GTK apps' own title-bar buttons, restored on off
NO_FILL="$STATE_DIR/no-fill"        # Settings: new windows don't fill free snap spots
SNAP_GAP=12
SNAP_TITLE_BAR=32                   # room left above a snapped window for its title bar
SNAP_STACK_MAX=3
# Day & Night uses the hills pair in both looks.
DAY_IMAGE="$HOME/Pictures/overtake/slideshow/1-hills-day.png"
NIGHT_IMAGE="$HOME/Pictures/overtake/slideshow/2-hills-night.png"

WINDOWS_BAR='{
  "position": "bottom",
  "transparent": false,
  "layout": {
    "left": [{ "id": "overtake.taskbar", "iconSize": 22 }],
    "center": [{ "id": "overtake.workspaces" }],
    "right": [
      { "id": "omarchy.system-update" },
      { "id": "omarchy.tray" },
      { "id": "omarchy.agents" },
      { "id": "omarchy.keyboard-layout" },
      { "id": "overtake.bluetooth" },
      { "id": "omarchy.network" },
      { "id": "overtake.audio" },
      { "id": "omarchy.power" },
      { "id": "omarchy.clock", "format": "h:mm AP   M/d/yyyy", "formatAlt": "dddd, MMMM d, yyyy", "verticalFormat": "h\n—\nmm" },
      { "id": "omarchy.indicators", "items": ["PasswordlessSudo", "RemoteSession", "ScreenRecording", "Reminder", "NightLight", "StayAwake"] },
      { "id": "overtake.notification-center" }
    ]
  }
}'

# Studio: a menu bar along the top (the focused app's menus on the left, the
# workspace numbers in the middle, status
# icons, Control Center and the clock on the right; the clock opens the
# notification center). The Dock is drawn by the overtake.taskbar service,
# which Omarchy loads only while its widget is on the bar: hence the hidden
# taskbar entry.
STUDIO_BAR='{
  "position": "top",
  "transparent": true,
  "layout": {
    "left": [{ "id": "overtake.menubar" }, { "id": "overtake.taskbar", "hidden": true }],
    "center": [{ "id": "overtake.workspaces" }],
    "right": [
      { "id": "omarchy.system-update" },
      { "id": "omarchy.tray" },
      { "id": "omarchy.agents" },
      { "id": "omarchy.indicators", "items": ["PasswordlessSudo", "RemoteSession", "ScreenRecording", "Reminder", "NightLight", "StayAwake"] },
      { "id": "omarchy.keyboard-layout" },
      { "id": "omarchy.power" },
      { "id": "overtake.bluetooth" },
      { "id": "omarchy.network" },
      { "id": "overtake.audio" },
      { "id": "overtake.control-center" },
      { "id": "overtake.notification-center", "clock": true }
    ]
  }
}'

SHELL_TOML="$HOME/.config/omarchy/shell.toml"
TOML_BEGIN="# >>> overtake (managed by ~/.local/bin/overtake)"
TOML_END="# <<< overtake"

notify() {
  omarchy-notification-send -g "$1" "$2" >/dev/null 2>&1 || return 0
  show_pending_notices
}
# For a notice that must not be lost: at login the shell may not own the
# notification service yet, and what the notice reports has already happened.
# One that can't be shown waits in the state folder for the next notification
# that gets through, or the next `overtake` command while the shell is up.
PENDING_NOTICES="$STATE_DIR/pending-notices"
notify_kept() {
  if omarchy-notification-send -g "$1" "$2" >/dev/null 2>&1; then
    show_pending_notices
  else
    keep_notice "$1" "$2"
  fi
}
keep_notice() {  # (once each; the folder is 0700 and the file 0600)
  grep -Fxqs -- "$1"$'\t'"$2" "$PENDING_NOTICES" && return 0
  ( umask 077; printf '%s\t%s\n' "$1" "$2" >>"$PENDING_NOTICES" ) 2>/dev/null || true
}
show_pending_notices() {
  local claimed="$PENDING_NOTICES.$$" glyph text
  # (renamed first, so two commands starting together don't both show them)
  mv -f "$PENDING_NOTICES" "$claimed" 2>/dev/null || return 0
  while IFS=$'\t' read -r glyph text; do
    omarchy-notification-send -g "$glyph" "$text" >/dev/null 2>&1 || keep_notice "$glyph" "$text"
  done <"$claimed"
  rm -f "$claimed"
}

name_list() {  # name_list a b c: "a, b and c"
  local out=""
  while (( $# > 2 )); do out+="$1, "; shift; done
  if (( $# == 2 )); then out+="$1 and $2"; else out+="${1:-}"; fi
  echo "$out"
}

# ---------- Overtake's patched copies of five Omarchy plugins ----------
# Built from the installed Omarchy and patched (patches/apply.py, kept in
# ~/.local/share/overtake). `build-copies all` is the installer's step;
# `build-copies update` runs after every `omarchy update` (a post-update hook)
# so the copies follow Omarchy's own code: rebuilt from the new Omarchy, and
# where a patch no longer fits, the copy is removed and Omarchy's own is used.
COPY_SPECS=(
  "workspaces|bar/widgets|Workspaces.manifest.json|Workspaces.qml"
  "bluetooth|panels/bluetooth|manifest.json|Panel.qml Model.js"
  "audio|panels/audio|manifest.json|Panel.qml Model.js"
  "notifications|notifications|manifest.json|Service.qml Toast.qml DeedButton.qml Delivery.js Detect.js Icons.js Layout.js Markup.js Security.js Store.js"
  "battery|services/battery|manifest.json|Service.qml BatteryModel.js"
)
# Copies a plugin the way `omarchy plugin clone` does (omarchy-plugin-clone's
# copy_plugin): a plugin with its own folder (manifest.json) is copied whole,
# so a file Omarchy adds to it comes along; one sharing a folder (a sibling
# *.manifest.json, like bar/widgets) brings its entry points and clonePaths.
copy_plugin_files() {  # copy_plugin_files <source-dir> <manifest-file> <target-dir>
  local dir=$1 manifest=$2 target=$3 s t
  if [[ $manifest == manifest.json ]]; then
    cp -rL "$dir/." "$target/" || return 1
    return 0
  fi
  cp -L "$dir/$manifest" "$target/manifest.json" || return 1
  while IFS=$'\t' read -r s t; do
    [[ -n $s && $s == "$t" && $t != /* && $t != *..* ]] || return 1   # (a renamed path: not supported, use Omarchy's own)
    if [[ -d $dir/$s ]]; then mkdir -p "$target/$t" && cp -rL "$dir/$s/." "$target/$t/" || return 1
    else mkdir -p "$(dirname "$target/$t")" && cp -L "$dir/$s" "$target/$t" || return 1; fi
  done < <(jq -r '[(.entryPoints[] | {source: ., target: .}), (.omarchy.clonePaths[]? | {source: .source, target: .target})]
                  | unique_by(.target)[] | [.source, .target] | @tsv' "$dir/$manifest")
}
# Omarchy's record of a copy: on its plugin list, or switched in for its own.
copy_recorded() {  # copy_recorded <name>
  jq -e --arg id "overtake.$1" '[(.plugins | arrays | .[] | if type == "object" then .id else . end),
                                 (.cloneSourceRestores | arrays | .[]),
                                 (.bar | .. | objects | .id? // empty)] | index($id) != null' "$SHELL_JSON" >/dev/null 2>&1
}
# Hand one copy back to Omarchy's own. Through the shell only when the shell
# lists the copy: asked to disable one it doesn't know (one it hasn't scanned,
# or one whose folder is gone), it answers "ok" and hands nothing back, which
# leaves no notification service. Otherwise in shell.json itself. With nothing
# recorded there is nothing to undo, and the shell isn't asked at all: any
# change it makes writes out its whole config, a full bar included.
hand_back_copy() {  # hand_back_copy <name>
  copy_recorded "$1" || return 0
  local i out
  if [[ -z ${OVERTAKE_NO_RELOAD:-} ]]; then
    for i in $(seq 20); do
      out=$(omarchy-shell shell listPlugins 2>&1) || true
      if jq -e --arg id "overtake.$1" 'any(.[]; .id == $id)' <<<"$out" >/dev/null 2>&1; then
        omarchy plugin disable "overtake.$1" >/dev/null 2>&1 && return 0
        break
      fi
      # (the shell is starting, or hasn't looked yet; a TTY or an SSH session has no shell to wait for)
      jq -e 'type == "array"' <<<"$out" >/dev/null 2>&1 || [[ $out == *"not responding"* || $out == *"not ready"* ]] || break
      omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true   # (files just written: ask it to look again)
      sleep 0.3
    done
  fi
  hand_back_in_shell_json "$1"
  [[ -n ${OVERTAKE_NO_RELOAD:-} ]] || omarchy-shell -q shell reloadConfig >/dev/null 2>&1 || true
}
# A hand-back an earlier run couldn't finish: a copy recorded in shell.json
# while the mode is off, or whose folder is gone, has Omarchy's own switched
# off with nothing in its place. At login, put that right.
repair_stale_copies() {
  local name
  for name in notifications battery; do
    [[ ! -f $FLAG || ! -d $HOME/.config/omarchy/plugins/overtake.$name ]] || continue
    copy_recorded "$name" || continue
    hand_back_in_shell_json "$name"
    [[ -n ${OVERTAKE_NO_RELOAD:-} ]] || omarchy-shell -q shell reloadConfig >/dev/null 2>&1 || true
  done
}
# Hand one plugin back to Omarchy's own in shell.json directly (when the shell
# can't be asked, as at login before it answers): the copy out of the plugin
# list, and Omarchy's own back on if the copy had switched it off.
hand_back_in_shell_json() {  # hand_back_in_shell_json <name>
  copy_recorded "$1" || return 0   # (nothing to undo: the file stays as it is)
  replace_with "$SHELL_JSON" jq --arg copy "overtake.$1" --arg own "omarchy.$1" '
    ((.cloneSourceRestores // []) | if type == "array" then index($copy) != null else false end) as $restore
    | (if (.plugins | type) == "array" then .plugins |= map(select((if type == "object" then .id else . end) != $copy)) else . end)
    | (if (.cloneSourceRestores | type) == "array" then .cloneSourceRestores |= map(select(. != $copy)) else . end)
    | (if $restore and (.disabledPlugins | type) == "array" then .disabledPlugins |= map(select(. != $own and . != $copy)) else . end)
    | (if (.bar | type) == "object" then (.bar | .. | objects | select(.id? == $copy) | .id) |= $own else . end)
    | (if .cloneSourceRestores == [] then del(.cloneSourceRestores) else . end)
    | (if .disabledPlugins == [] then del(.disabledPlugins) else . end)' "$SHELL_JSON" || true
}

build_copies() {  # build_copies all|update
  # One build at a time (install, login and the update hook can overlap), and
  # a build that was stopped halfway leaves nothing behind.
  exec 7>"$STATE_DIR/.build.lock"
  flock 7
  local mode=$1 share="$HOME/.local/share/overtake" plugins="$HOME/.config/omarchy/plugins"
  local source_root="${OVERTAKE_OMARCHY_PLUGINS:-${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins}"
  local spec name src manifest files target tmp f built="" same="" failed="" kept="" unbuilt="" absent="" ok fits n dropped="" aside applied
  local left_out="$STATE_DIR/copies-left-out"
  [[ -f $share/apply.py ]] || { echo "overtake: the patcher isn't installed; run ./install.sh again" >&2; return 1; }
  # No Omarchy to build from (mid-upgrade, a wrong path): that says nothing about
  # whether the patches fit, so nothing changes.
  [[ -d $source_root ]] || { echo "Overtake Mode: Omarchy's plugins weren't found in $source_root; nothing changed" >&2; exec 7>&-; return 0; }
  mkdir -p "$plugins"
  rm -rf "${plugins:?}"/.overtake-build.*
  # (an install starts these notices over: what it can't build is said afresh)
  [[ $mode != all ]] || rm -f "$PENDING_NOTICES" "$STATE_DIR/bar-fixes.missing"
  for spec in "${COPY_SPECS[@]}"; do
    IFS='|' read -r name src manifest files <<<"$spec"
    target="$plugins/overtake.$name"
    [[ $mode == all || -d $target ]] || { absent+=" $name"; continue; }
    # (a dot folder: the shell doesn't load it)
    tmp=$(mktemp -d "$plugins/.overtake-build.XXXXXX") || { if [[ -d $target ]]; then kept+=" $name"; else unbuilt+=" $name"; fi; continue; }
    chmod 755 "$tmp"                                     # (mktemp makes it 0700; match the other plugin folders)
    ok=1 fits=1
    # Omarchy changed only if Omarchy itself no longer has the files the patches
    # need. (Looked for in its folder, not in the copy being made: on a full disk
    # a file can be missing from there too.)
    for f in "$manifest" $files; do [[ -e $source_root/$src/$f ]] || { ok="" fits=""; }; done
    [[ -z $ok ]] || copy_plugin_files "$source_root/$src" "$manifest" "$tmp" 2>/dev/null || ok=""
    if [[ $ok ]] && jq --arg id "overtake.$name" --arg name "Overtake ${name^}" --arg from "omarchy.$name" '
        .id = $id | .name = $name
        | .author = ((.author // "Omarchy") + ", patched by Overtake Mode")
        | if (.barWidget | type) == "object" then .barWidget.displayName = $name else . end
        | .omarchy = ((if (.omarchy | type) == "object" then .omarchy else {} end) + { clonedFrom: $from })
        | del(.omarchy.clonePaths)' "$tmp/manifest.json" >"$tmp/manifest.json.new" 2>/dev/null &&
       mv "$tmp/manifest.json.new" "$tmp/manifest.json" &&
       cp "$share/NOTICE.md" "$tmp/NOTICE.md" 2>/dev/null &&
       { # (3: the patch doesn't fit. Any other failure, such as a write that
         # fails at close, is a failed build that keeps the copy from before.)
         python3 -I "$share/apply.py" "$name" "$tmp" >/dev/null 2>&1; n=$?
         [[ $n != 3 ]] || fits=""
         (( n == 0 )); }; then
      if [[ -d $target ]] && diff -rq "$tmp" "$target" >/dev/null 2>&1; then
        rm -rf "${tmp:?}"            # unchanged: leave the running copy alone
        chmod 755 "$target"          # (copies built by 0.1.8 are 0700)
        same+=" $name"
      else
        # (the old copy goes only once the new one is in its place)
        aside=$plugins/.overtake-build.old-$name
        rm -rf "${aside:?}"
        if { [[ ! -d $target ]] || mv -T "$target" "$aside"; } && mv -T "$tmp" "$target"; then
          rm -rf "${aside:?}"; built+=" $name"
        else
          [[ -d $target || ! -d $aside ]] || mv -T "$aside" "$target" || true
          rm -rf "${tmp:?}" "${aside:?}"
          if [[ -d $target ]]; then kept+=" $name"; else unbuilt+=" $name"; fi
        fi
      fi
    else
      rm -rf "${tmp:?}"
      # Only when Omarchy's code no longer fits the patch (apply.py exit 3, or
      # files it needs are gone); a passing error (disk full, a missing tool)
      # leaves the working copy as it is.
      if [[ -z $fits && -d $target ]]; then     # Omarchy's own back in its place
        # through the shell if it knows the copy; otherwise (at login it may not
        # yet) in shell.json itself, so Omarchy's own isn't left switched off
        hand_back_copy "$name"
        rm -rf "${target:?}"
      fi
      if [[ -z $fits ]]; then failed+=" $name"
      elif [[ -d $target ]]; then kept+=" $name"
      else unbuilt+=" $name"; fi
    fi
  done
  # Which copies are out because their patch no longer fits, for
  # fix_bar_widgets: a name stays until a build of it works.
  for n in $(cat "$left_out" 2>/dev/null || true) $failed; do
    [[ " $same$built " == *" $n "* || " $dropped " == *" $n "* ]] || dropped+=" $n"
  done
  if [[ -n $dropped ]]; then echo "${dropped# }" >"$left_out" 2>/dev/null || true; else rm -f "$left_out"; fi
  if [[ -n $built ]]; then echo "Overtake Mode: patched copies of Omarchy's plugins built:$built"
  elif [[ -z $failed$kept$unbuilt$absent ]]; then echo "Overtake Mode: patched copies of Omarchy's plugins unchanged"; fi
  [[ -z $absent ]] || echo "Overtake Mode: no copy here, so Omarchy's own is used (./install.sh builds one if this Omarchy fits):$absent"
  [[ -z $failed ]] || echo "Overtake Mode: left out, Omarchy's own is used:$failed"
  [[ -z $kept ]] || echo "Overtake Mode: couldn't rebuild, so the copy from before stays in use:$kept" >&2
  [[ -z $unbuilt ]] || echo "Overtake Mode: couldn't build, so Omarchy's own is used (run ./install.sh again to retry):$unbuilt" >&2
  exec 7>&-   # (the build lock goes no further than the build)
  if [[ $mode == update ]]; then
    # (the names of Overtake's own copies, split on purpose)
    [[ -z $failed ]] || notify_kept $'\uf0ec' "Overtake Mode: Omarchy changed, so Omarchy's own version is used for $(name_list $failed) until an Overtake update supports this Omarchy"
    [[ -z $kept ]] || notify_kept $'\uf071' "Overtake Mode couldn't rebuild its copy for $(name_list $kept), so the copy from before stays in use. It tries again at the next login."
  fi
  return 0
}

# Taller taskbar (Omarchy default is 26) in Classic, a slim menu bar in
# Studio, kept in a marked block of the machine-level shell.toml so turning
# the mode off removes exactly it.
add_bar_size() {
  [[ -f $SHELL_TOML ]] || { : >"$SHELL_TOML"; touch "$STATE_DIR/created-shell-toml"; }
  if [[ $(style) == studio ]]; then
    replace_with "$SHELL_TOML" bar_size_toml 30 13
  else
    replace_with "$SHELL_TOML" bar_size_toml 40 15
  fi
}

# shell.toml less Overtake's block. Lines are held from a start until its end: a start
# with no end, and your lines after it, stay.
toml_without_block() {
  awk -v b="$TOML_BEGIN" -v e="$TOML_END" '
    function flush(i) { for (i = 1; i <= n; i++) print held[i]; n = 0 }
    $0 == b { flush(); open = 1; n = 1; held[1] = $0; next }
    open && $0 == e { open = 0; n = 0; next }
    open { held[++n] = $0; next }
    { print }
    END { flush() }' "$SHELL_TOML"
}

bar_size_toml() {  # bar_size_toml <bar size> <icon font>: shell.toml with Overtake's block (once) at the end
  # (awk ends a last line that has no newline: noted, so that goes again with the block)
  if [[ -s $SHELL_TOML && -n $(tail -c 1 "$SHELL_TOML") ]]; then touch "$STATE_DIR/shell-toml-no-newline"; fi
  toml_without_block
  printf '%s\n[bar]\nsize-horizontal = %s\nicon-font = %s\n%s\n' "$TOML_BEGIN" "$1" "$2" "$TOML_END"
}

overtake_bar_showing() {  # Overtake's bar is in shell.json (whether or not the mode flag says on)
  jq -e '[.bar | .. | .id? // empty] | (index("overtake.taskbar") or index("overtake.menubar"))' "$SHELL_JSON" >/dev/null 2>&1
}

# A shell.json Overtake can't work with is said plainly, before anything changes.
require_shell_json() {
  local problem=""
  if [[ ! -e $SHELL_JSON ]]; then problem="is missing"
  elif [[ ! -s $SHELL_JSON ]]; then problem="is empty"
  elif ! jq -e 'type == "object"' "$SHELL_JSON" >/dev/null 2>&1; then problem="isn't valid JSON"
  fi
  [[ -z $problem ]] && return 0
  echo "overtake: ~/.config/omarchy/shell.json $problem, so nothing was changed. Fix or restore that file (restarting Omarchy's shell with omarchy-restart-shell may write a new one), then try again." >&2
  exit 1
}

# Omarchy's settings files are replaced whole: a temp file next to the real one
# (the link's target, if it's a symlink), renamed over it once it's complete.
# The shell never reads a half-written file, and a full /tmp can't empty it.
replace_with() {  # replace_with <file> <command...>: the command's output becomes the file
  local file target tmp
  file=$1; shift
  target=$(readlink -f "$file") || return 1
  tmp=$(mktemp "$target.XXXXXX") || return 1
  if "$@" >"$tmp"; then
    chmod --reference="$target" "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$target"
  else
    rm -f "$tmp"
    return 1
  fi
}

remove_bar_size() {
  [[ -f $SHELL_TOML ]] || return 0
  # (a second `off` finds it gone, and leaves the file byte for byte)
  if grep -qxF "$TOML_BEGIN" "$SHELL_TOML" && grep -qxF "$TOML_END" "$SHELL_TOML"; then
    replace_with "$SHELL_TOML" toml_without_block
    if [[ -f $STATE_DIR/shell-toml-no-newline ]]; then
      [[ -n $(tail -c 1 "$SHELL_TOML") ]] || replace_with "$SHELL_TOML" head -c -1 "$SHELL_TOML"
    fi
  fi
  rm -f "$STATE_DIR/shell-toml-no-newline"
  # Overtake created it and nothing else was added: the file goes too.
  if [[ -f $STATE_DIR/created-shell-toml && ! -L $SHELL_TOML && -z $(tr -d '[:space:]' <"$SHELL_TOML") ]]; then
    rm -f "$SHELL_TOML"
  fi
  rm -f "$STATE_DIR/created-shell-toml"
}

# The bar layout in shell.json (fails, leaving the file as it was, if the
# layout isn't valid JSON).
set_bar() {
  # (the bar's settings, which can name your cities or places, through a file
  # descriptor rather than the command line)
  jq -e 'type == "object"' <<<"$1" >/dev/null 2>&1 || return 1
  replace_with "$SHELL_JSON" jq --slurpfile bar <(printf '%s' "$1") '.bar = $bar[0]' "$SHELL_JSON"
}

next_wallpaper() {
  local slides=() index=-1
  shopt -s nullglob
  slides=("$SLIDESHOW_DIR"/*)
  shopt -u nullglob
  (( ${#slides[@]} )) || return 0
  [[ -s $SLIDE_INDEX ]] && index=$(<"$SLIDE_INDEX")
  [[ $index =~ ^-?[0-9]+$ ]] || index=-1
  index=$(( (index + 1) % ${#slides[@]} ))
  echo "$index" >"$SLIDE_INDEX"
  show_slide "${slides[$index]}"
}

show_slide() {
  set_background "$1" || true
  readlink -f "$CURRENT_BG" >"$SLIDE_SHOWN"
}

# Put a wallpaper up the way omarchy-theme-bg-set does (repoint Omarchy's link,
# tell the shell), without its path in any command line: that helper takes the
# path as an argument and passes it on, and a picture's name can be private.
# The path goes through the environment, and the shell's `background refresh`
# reads the link itself.
set_background() {  # set_background <file>
  OVERTAKE_BG=$1 OVERTAKE_BG_LINK=$CURRENT_BG python3 -I -c '
import os
path = os.path.realpath(os.environ["OVERTAKE_BG"])
link = os.environ["OVERTAKE_BG_LINK"]
if not os.path.isfile(path):
    raise SystemExit(1)
os.makedirs(os.path.dirname(link), exist_ok=True)
temp = link + ".overtake-" + str(os.getpid())
os.symlink(path, temp)
os.replace(temp, link)
' >/dev/null 2>&1 || return 1
  omarchy-shell -q background refresh >/dev/null 2>&1 || true
}

# A wallpaper you put up yourself (Omarchy's picker, a theme's own, an
# animated one) rather than the slideshow: it stays until next-wallpaper.
picked_wallpaper() {
  local bg
  bg=$(readlink -f "$CURRENT_BG" 2>/dev/null) || return 1
  [[ -n $bg ]] || return 1
  # (before slide-shown was kept, any slideshow picture counts as the slideshow's)
  [[ -f $SLIDE_SHOWN ]] || { [[ $bg != "$HOME/Pictures/overtake/"* ]]; return; }
  [[ $bg != "$(<"$SLIDE_SHOWN")" ]]
}

# ---------- Each mode's look ----------
# Omarchy (Overtake Mode off), Classic and Studio each remember their theme
# and wallpaper: saved on leaving a mode, put back on returning. A theme's
# own wallpaper is kept by name, since switching themes replaces its folder.
current_mode() { [[ -f $FLAG ]] && style || echo omarchy; }

save_look() {  # save_look <mode>
  local bg
  mkdir -p "$LOOKS_DIR"
  cp "$CURRENT_THEME_NAME" "$LOOKS_DIR/$1.theme" 2>/dev/null || true
  bg=$(readlink -f "$CURRENT_BG" 2>/dev/null) || bg=""
  [[ $bg == "$HOME/.local/state/omarchy/current/"* ]] && bg="theme:${bg##*/}"
  # (a full disk mustn't stop a switch: this mode just forgets its look)
  echo "$bg" 2>/dev/null >"$LOOKS_DIR/$1.bg" || true
  if [[ $1 != omarchy ]] && picked_wallpaper; then echo 1 2>/dev/null >"$LOOKS_DIR/$1.picked" || true; else rm -f "$LOOKS_DIR/$1.picked"; fi
}

# Puts back a mode's theme, and its wallpaper when it has one to keep (the
# Omarchy look's always; Classic's or Studio's only if you picked it). Fails
# when the wallpaper is left to the slideshow.
apply_look() {  # apply_look <mode>
  local theme bg keep="" src="" dir
  theme=$(cat "$LOOKS_DIR/$1.theme" 2>/dev/null || true)
  bg=$(cat "$LOOKS_DIR/$1.bg" 2>/dev/null || true)
  # A wallpaper to put back: switch the theme without its own wallpaper
  # (OMARCHY_THEME_SKIP_BACKGROUND, as omarchy-theme-refresh does), so the
  # theme's default doesn't show for a moment before this one.
  [[ ($1 == omarchy || -f $LOOKS_DIR/$1.picked) && -n $bg ]] && keep=1
  if [[ -n $keep ]]; then
    # Where it really lives: a theme's own picture from that theme's folder,
    # not from the current-theme copy the switch is about to replace.
    if [[ $bg == theme:* ]]; then
      for dir in "$HOME/.config/omarchy/backgrounds/$theme" "$HOME/.config/omarchy/themes/$theme/backgrounds" \
                 "${OMARCHY_PATH:-/usr/share/omarchy}/themes/$theme/backgrounds"; do
        [[ -n $theme && -f $dir/${bg#theme:} ]] && { src=$dir/${bg#theme:}; break; }
      done
    elif [[ -f $bg ]]; then
      src=$bg
    fi
    # set first, so the wallpaper never points into a theme folder that's gone
    [[ -z $src || $CURRENT_BG -ef $src ]] || set_background "$src" || true
  fi
  if [[ -n $theme && $theme != "$(cat "$CURRENT_THEME_NAME" 2>/dev/null)" ]]; then
    OMARCHY_THEME_SKIP_BACKGROUND=${keep:+1} omarchy-theme-set "$theme" >/dev/null 2>&1 || true
  fi
  [[ -n $keep ]] || return 1
  if [[ -z $src ]]; then
    [[ $bg == theme:* ]] && bg="$HOME/.local/state/omarchy/current/theme/backgrounds/${bg#theme:}"
    if [[ ! -f $bg ]]; then
      # gone (theme removed or renamed): the theme's own first wallpaper
      # instead (not a whole theme re-apply)
      local first
      first=$(find -L "$HOME/.local/state/omarchy/current/theme/backgrounds" -maxdepth 1 -type f 2>/dev/null | sort | head -1)
      [[ -n $first ]] && set_background "$first" || true
      return 1
    fi
    [[ $CURRENT_BG -ef $bg ]] || set_background "$bg" || true
  fi
  mark_picked
}

# A wallpaper you picked can be one of the slideshow's own pictures, even the
# one it showed last; then picked_wallpaper would take it for the slideshow's
# and the mode would drop it. Clear what the slideshow showed, so it can't.
mark_picked() {
  mkdir -p -m 700 "$STATE_DIR"
  echo picked >"$SLIDE_SHOWN"
}

wallpaper_mode() {
  [[ -s $WALLPAPER_MODE_FILE && $(<"$WALLPAPER_MODE_FILE") == day-night ]] && echo day-night || echo rotate
}

# Today's sunrise and sunset as HHMM, from wttr.in's IP-located astronomy data
# (the same source Omarchy's weather widget uses), cached per day. Falls back to
# 07:00/19:00 when offline.
sun_times() {
  local cache="$STATE_DIR/sun-$(date +%F)" times
  if [[ ! -s $cache ]]; then
    rm -f "$STATE_DIR"/sun-*
    # (at most 256 KB read, whatever the server sends; the two times must look
    # like "06:52 AM" before they reach date)
    times=$(curl -fs --max-time 8 --max-filesize 262144 'https://wttr.in/?format=j1' | head -c 262144 |
      jq -r '.weather[0].astronomy[0] | "\(.sunrise)|\(.sunset)"' 2>/dev/null) || true
    local rise="" set=""
    if [[ $times =~ ^[0-9]{1,2}:[0-9]{2}\ ?([AaPp][Mm])?\|[0-9]{1,2}:[0-9]{2}\ ?([AaPp][Mm])?$ ]] &&
       rise=$(date -d "${times%%|*}" +%H%M 2>/dev/null) && set=$(date -d "${times##*|}" +%H%M 2>/dev/null); then
      echo "$rise $set" >"$cache"   # (cached only when both are real times)
    else
      echo "0700 1900"
      return
    fi
  fi
  cat "$cache"
}

apply_day_night() {
  local sunrise sunset now image
  read -r sunrise sunset < <(sun_times)
  [[ $sunrise =~ ^[0-9]{4}$ && $sunset =~ ^[0-9]{4}$ ]] || { sunrise=0700 sunset=1900; }
  now=$(date +%H%M)
  if (( 10#$now >= 10#$sunrise && 10#$now < 10#$sunset )); then image=$DAY_IMAGE; else image=$NIGHT_IMAGE; fi
  # (recorded even when it's already up, so it isn't taken for one you picked)
  if [[ $CURRENT_BG -ef $image ]]; then readlink -f "$CURRENT_BG" >"$SLIDE_SHOWN"; else show_slide "$image"; fi
}

refresh_wallpaper() {
  if [[ $(wallpaper_mode) == day-night ]]; then apply_day_night; else next_wallpaper; fi
}

set_wallpaper_mode() {
  case "$1" in
    rotate | day-night) ;;
    *) echo "Usage: overtake wallpaper-mode [rotate|day-night]" >&2; exit 1 ;;
  esac
  mkdir -p -m 700 "$STATE_DIR"
  echo "$1" >"$WALLPAPER_MODE_FILE"
  if [[ -f $FLAG ]]; then
    refresh_wallpaper
    start_slideshow
  fi
  [[ $1 == day-night ]] && notify $'' "Wallpaper: Day & Night (follows sunrise and sunset)" ||
    notify $'' "Wallpaper: Rotate (every $SLIDESHOW_MINUTES minutes)"
}

stop_slideshow() {
  # the loop runs in its own session (setsid), so its group is the loop and
  # its sleep: stop both. Only if that pid is still the loop: the file outlives
  # a reboot, and by then the number can belong to any other process.
  local pid
  pid=$(cat "$SLIDESHOW_PID" 2>/dev/null || true)
  if [[ $pid =~ ^[0-9]+$ ]] && tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'overtake slideshow-loop'; then
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
  fi
  rm -f "$SLIDESHOW_PID"
}

start_slideshow() {
  (
    flock 7
    stop_slideshow
    # (without the lock's handle; the loop records its own pid: $! would be
    # setsid's, which can fork and exit, leaving the loop unstoppable)
    setsid overtake slideshow-loop </dev/null >/dev/null 2>&1 7>&- &
  ) 7>"$STATE_DIR/.slideshow.lock"
}

# A theme's live (animated) wallpaper: <theme>/live/<name>.frag.qsb next to
# <theme>/backgrounds/<name>.*, drawn by the live-wallpaper shell plugin. The
# slideshow leaves one alone; next-wallpaper still switches away by hand.
live_wallpaper_showing() {
  local bg
  bg=$(readlink -f "$CURRENT_BG" 2>/dev/null) || return 1
  [[ $bg == */backgrounds/* ]] || return 1
  local name=${bg##*/}
  [[ -f ${bg%/backgrounds/*}/live/${name%.*}.frag.qsb ]]
}

# Rotate changes the picture every SLIDESHOW_MINUTES; Day & Night only checks
# every 5 minutes whether the sun has come up or gone down. Neither replaces
# a wallpaper you picked (see picked_wallpaper).
slideshow_loop() {
  # one loop at a time: two quick starts can each launch one before either
  # has written its pid, and the later one quits here
  exec 8>"$STATE_DIR/.slideshow-run.lock"
  flock -n 8 || return 0
  echo $$ >"$SLIDESHOW_PID"
  while [[ -f $FLAG ]]; do
    if [[ $(wallpaper_mode) == day-night ]]; then
      sleep 300 && [[ -f $FLAG ]] && ! picked_wallpaper && apply_day_night
    else
      sleep $(( SLIDESHOW_MINUTES * 60 )) && [[ -f $FLAG ]] && ! picked_wallpaper && next_wallpaper
    fi
  done
}

# on/off/toggle run one at a time (a double-tapped shortcut, or the menu and a
# shortcut together, would otherwise interleave and save the Overtake bar as
# "your" bar).
# A lock folder rather than flock: programs on/off start (the slideshow loop,
# the restarted shell) would inherit a lock file's handle and hold it forever.
# One left by a killed run is cleared after a minute.
MODE_LOCK="$STATE_DIR/.mode.lock.d"
mode_lock() {
  local i err
  mkdir -p -m 700 "$STATE_DIR"
  for i in $(seq 120); do
    if err=$(LC_ALL=C mkdir "$MODE_LOCK" 2>&1); then
      trap 'rmdir "$MODE_LOCK" 2>/dev/null' EXIT
      trap 'exit 143' TERM HUP INT   # (so a stopped on/off still lets go of the lock)
      return 0
    fi
    # (not a lock in the way: the disk is read-only or full)
    [[ -d $MODE_LOCK ]] || { echo "overtake: can't write to $STATE_DIR: ${err##*: }" >&2; exit 1; }
    # left by one that died: older than a minute
    (( $(date +%s) - $(stat -c %Y "$MODE_LOCK" 2>/dev/null || date +%s) > 60 )) && { rmdir "$MODE_LOCK" 2>/dev/null || true; }
    sleep 0.5
  done
  echo "overtake: another on/off is still running" >&2
  exit 1
}

# The bar for the current look. Keeps the user's own battery widget if their
# Omarchy bar has a custom one (a clone of omarchy.power), and in Classic the
# taskbar's settings (pinned apps) from last time.
style_bar() {
  local bar power
  power=$(jq -r '[.. | .id? // empty | select(test("\\.power$"))][0] // "omarchy.power"' "$SAVED_BAR" 2>/dev/null || echo omarchy.power)
  [[ -n $power ]] || power=omarchy.power
  if [[ $(style) == studio ]]; then bar=$STUDIO_BAR; else bar=$WINDOWS_BAR; fi
  bar=$(jq --arg p "$power" '(.layout.right[] | select(.id == "omarchy.power") | .id) = $p' <<<"$bar")
  # A patched widget the installer had to skip: use Omarchy's own.
  local widget
  for widget in workspaces bluetooth audio; do
    [[ -d $HOME/.config/omarchy/plugins/overtake.$widget ]] && continue
    bar=$(jq --arg from "overtake.$widget" --arg to "omarchy.$widget" \
      '(.. | objects | select(.id? == $from) | .id) = $to' <<<"$bar")
  done
  if [[ $(style) == classic ]]; then
    # (pins kept by an uninstall wait in ~/.config/overtake)
    [[ -s $TASKBAR_SETTINGS || ! -s $HOME/.config/overtake/taskbar-settings.json ]] || cp "$HOME/.config/overtake/taskbar-settings.json" "$TASKBAR_SETTINGS"
    [[ -s $TASKBAR_SETTINGS ]] && bar=$(jq --slurpfile t "$TASKBAR_SETTINGS" '.layout.left = [$t[0]]' <<<"$bar")
  fi
  echo "$bar"
}

# Overtake's copies of three bar widgets can get swapped back to Omarchy's
# (disabling a copy does that, so can a rewritten shell.json), which brings
# back their quirks: no empty workspaces above 5, right-click turning
# Bluetooth off or muting everything. While the mode is on, put the copies
# back; one that isn't there is left alone, with a notification.
fix_bar_widgets() {
  [[ -f $FLAG && -s $SHELL_JSON ]] || return 0
  jq -e '[.bar | .. | .id? // empty] | (index("overtake.taskbar") or index("overtake.menubar"))' "$SHELL_JSON" >/dev/null 2>&1 || return 0
  local bar widget fixed=() missing=()
  bar=$(jq '.bar' "$SHELL_JSON")
  for widget in workspaces bluetooth audio; do
    jq -e --arg id "omarchy.$widget" '[.. | .id? // empty] | index($id)' <<<"$bar" >/dev/null || continue
    if [[ -d $HOME/.config/omarchy/plugins/overtake.$widget ]]; then
      bar=$(jq --arg from "omarchy.$widget" --arg to "overtake.$widget" \
        '(.. | objects | select(.id? == $from) | .id) = $to' <<<"$bar")
      fixed+=("$widget")
    else
      missing+=("$widget")
    fi
  done
  if (( ${#fixed[@]} )); then
    set_bar "$bar"
    omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
    echo "$(date '+%F %T') put back Overtake's ${fixed[*]} (the bar had Omarchy's)" >>"$STATE_DIR/bar-fixes.log"
    # the last 200 are plenty
    (( $(wc -l <"$STATE_DIR/bar-fixes.log") > 400 )) && sed -i '1,200d' "$STATE_DIR/bar-fixes.log" || true
  fi
  # Said once, not on every bar change. A copy dropped because its patch no
  # longer fits this Omarchy needs an Overtake update (installing the same
  # version again would drop it again); one missing for any other reason comes
  # back with an install.
  local said="$STATE_DIR/bar-fixes.missing" left_out unfit=() absent=()
  left_out=" $(cat "$STATE_DIR/copies-left-out" 2>/dev/null || true) "
  for widget in ${missing[@]+"${missing[@]}"}; do
    if [[ $left_out == *" $widget "* ]]; then unfit+=("$widget"); else absent+=("$widget"); fi
  done
  if (( ${#missing[@]} == 0 )); then
    rm -f "$said"
  elif [[ $(cat "$said" 2>/dev/null) != "${unfit[*]-}|${absent[*]-}" ]]; then
    echo "${unfit[*]-}|${absent[*]-}" >"$said"
    (( ${#unfit[@]} == 0 )) || notify_kept $'\uf071' "Omarchy's own version is used for $(name_list "${unfit[@]}") until an Overtake update supports this Omarchy."
    (( ${#absent[@]} == 0 )) || notify_kept $'\uf071' "The bar uses Omarchy's version of $(name_list "${absent[@]}") because Overtake's isn't installed. Installing Overtake again (./install.sh) brings it back."
  fi
}

# The taskbar's settings (pins) out of the live bar, kept while the mode is
# off or the look is Studio.
save_taskbar_settings() {
  jq '[.bar.layout[][]? | select(.id == "overtake.taskbar")][0] // empty' "$SHELL_JSON" >"$TASKBAR_SETTINGS.tmp" \
    && [[ -s $TASKBAR_SETTINGS.tmp ]] && mv "$TASKBAR_SETTINGS.tmp" "$TASKBAR_SETTINGS" || rm -f "$TASKBAR_SETTINGS.tmp"
}

# Studio's options, in ~/.config/overtake/studio.json (the Dock reads it live).
STUDIO_JSON="$HOME/.config/overtake/studio.json"
studio_get() {
  local value=""
  [[ -s $STUDIO_JSON ]] && value=$(jq -r --arg k "$1" 'if type == "object" then .[$k] // empty else empty end' "$STUDIO_JSON" 2>/dev/null || true)
  case $1 in
    dockSize) case ${value:-48} in 40) echo Small ;; 64) echo Large ;; *) echo Medium ;; esac ;;
    dockMagnify) [[ $value != false ]] ;;     # on unless turned off
    dockAutohide) [[ $value == true ]] ;;
    *) echo "overtake: studio-get takes dockSize, dockMagnify or dockAutohide" >&2; return 1 ;;
  esac
}
studio_set() {
  local key=$1 value
  case $key:${2,,} in
    dockSize:small) value=40 ;; dockSize:medium) value=48 ;; dockSize:large) value=64 ;;
    dockMagnify:on | dockAutohide:on) value=true ;;
    dockMagnify:off | dockAutohide:off) value=false ;;
    *) echo "overtake: studio-set takes dockSize small|medium|large, dockMagnify on|off or dockAutohide on|off" >&2; return 1 ;;
  esac
  mkdir -p "$(dirname "$STUDIO_JSON")"
  # (locked and replaced whole; a damaged file starts over)
  jq -e . "$STUDIO_JSON" >/dev/null 2>&1 || echo '{}' >"$STUDIO_JSON"
  json_set "$STUDIO_JSON" '(if type == "object" then . else {} end) | .[$k] = $v' --arg k "$key" --argjson v "$value"
}

# Switch between Classic and Studio. While the mode is on, the bar, its
# size, the shortcuts and (when the slideshow is showing) the wallpaper
# change in place; windows stay where they are.
set_style() {
  case "$1" in
    classic | studio) ;;
    *) echo "Usage: overtake style [classic|studio]" >&2; exit 1 ;;
  esac
  local before
  [[ ! -f $FLAG ]] || require_shell_json
  before=$(style)
  mkdir -p "$(dirname "$STYLE_FILE")"
  if [[ -f $FLAG && $before == classic ]]; then save_taskbar_settings; fi
  [[ -f $FLAG && $before != "$1" ]] && save_look "$before"
  echo "$1" >"$STYLE_FILE"
  [[ -f $FLAG ]] || { notify $'\uf0ec' "Overtake mode: ${1^} (applies when Overtake Mode is on)"; return 0; }
  [[ $before == "$1" ]] && return 0
  set_bar "$(style_bar)"
  add_bar_size
  # The new look's theme, and its wallpaper if you picked one there; else its
  # slideshow (re-run, in a new process: this one still has the old look's
  # folder and day/night pictures).
  if apply_look "$1"; then
    overtake resume-wallpaper >/dev/null 2>&1 || true
  else
    rm -f "$SLIDE_INDEX" "$SLIDE_SHOWN"
    overtake resume-wallpaper refresh >/dev/null 2>&1 || true
  fi
  hyprctl reload >/dev/null || true
  setsid sh -c 'sleep 1.5; overtake relayout all' </dev/null >/dev/null 2>&1 &
  notify $'\uf0ec' "Overtake mode: ${1^}"
}

# Omarchy 4.5's floating workspaces bring their own title bars and Dock, which
# would double Overtake's. While the mode is on, a workspace (or the default)
# set to floating is tiled in Omarchy's own record instead (Overtake floats
# every window itself); turning the mode off puts each record back as it was.
OMARCHY_LAYOUTS="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layouts"
PAUSED_LAYOUTS="$STATE_DIR/omarchy-floating-layouts"
pause_floating_layouts() {
  local f
  [[ -d $OMARCHY_LAYOUTS ]] || return 0
  for f in "$OMARCHY_LAYOUTS"/*.lua; do
    [[ -f $f && ! -L $f ]] && grep -q '"floating"' "$f" || continue
    mkdir -p -m 700 "$PAUSED_LAYOUTS"
    [[ -e $PAUSED_LAYOUTS/${f##*/} ]] || cp -p "$f" "$PAUSED_LAYOUTS/${f##*/}"
    replace_with "$f" sed 's/"floating"/"dwindle"/g' "$f" || true
  done
}
resume_floating_layouts() {
  local f
  [[ -d $PAUSED_LAYOUTS ]] || return 0
  local live tmp="" failed=""
  for f in "$PAUSED_LAYOUTS"/*.lua; do
    [[ -f $f ]] || continue
    live="$OMARCHY_LAYOUTS/${f##*/}"
    # only one still as Overtake left it: a layout you chose while the mode
    # was on (or a record Omarchy removed) stays as it is now
    if [[ -f $live ]] && [[ $(<"$live") == "$(sed 's/"floating"/"dwindle"/g' "$f")" ]]; then
      tmp=$(mktemp "$OMARCHY_LAYOUTS/.${f##*/}.XXXXXX") && cp -p "$f" "$tmp" && mv -f "$tmp" "$live" || { rm -f "${tmp:-}"; failed=1; }
    fi
  done
  [[ -n $failed ]] || rm -rf "${PAUSED_LAYOUTS:?}"
}

# Overtake's copies of Omarchy's notifications and battery services run only
# while Classic or Studio is on; in Omarchy mode Omarchy's own run. Switched
# through the running shell (Omarchy turns its own off while a copy is on and
# back on when the copy goes); not in a test install (OVERTAKE_NO_RELOAD).
switch_copies() {  # switch_copies on|off
  [[ -z ${OVERTAKE_NO_RELOAD:-} ]] || return 0
  local id out i ok
  for id in notifications battery; do
    # (no shell to ask, a TTY or an SSH session: switching off is done in
    # shell.json itself, so Omarchy's own run when the shell next starts)
    if [[ $1 == off ]]; then hand_back_copy "$id"; continue; fi
    [[ -d $HOME/.config/omarchy/plugins/overtake.$id ]] || continue
    ok=""
    for i in $(seq 20); do
      out=$(omarchy plugin enable "overtake.$id" 2>&1) && { ok=1; break; }
      [[ $out == *"not known"* || $out == *"not responding"* || $out == *"not ready"* ]] || break   # (or the shell is restarting)
      omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true   # (files just written: ask it to look again)
      sleep 0.3
    done
    [[ -n $ok ]] || echo "overtake: couldn't switch overtake.$id on (${out:-no reply from the shell}); afterwards run: omarchy plugin enable overtake.$id" >&2
  done
}

turn_on() {
  [[ -f $FLAG ]] && { echo "Overtake Mode is already on"; fix_bar_widgets; return; }
  require_shell_json
  require_session
  finish_switch_off
  # (an install stopped partway, say on a full disk: no bar without its plugin)
  local plugin
  for plugin in overtake.taskbar overtake.menubar overtake.notification-center overtake.control-center; do
    [[ -f $HOME/.config/omarchy/plugins/$plugin/manifest.json ]] || { echo "overtake: its plugins aren't all installed; run ./install.sh again" >&2; exit 1; }
  done
  mkdir -p -m 700 "$STATE_DIR"
  if jq -e '[.bar | .. | .id? // empty] | (index("overtake.taskbar") or index("overtake.menubar"))' "$SHELL_JSON" >/dev/null 2>&1; then
    echo "the bar is already Overtake's; keeping the saved Omarchy bar" >&2
  else
    jq '.bar' "$SHELL_JSON" >"$SAVED_BAR"
    omarchy-version >"$SAVED_BAR.omarchy" 2>/dev/null || true   # (which Omarchy the saved bar is from)
  fi
  readlink -f "$CURRENT_BG" >"$SAVED_BG" 2>/dev/null || true
  save_look omarchy
  set_bar "$(style_bar)"
  add_bar_size
  hyprctl clients -j | jq -c '[.[] | select(.workspace.id > 0 and .floating) | .address]' >"$KEEP_FLOATING" 2>/dev/null || true
  hyprctl clients -j | jq -c '[.[] | select(.workspace.id > 0 and (.floating | not)) | {address, ws: .workspace.id, at, size}]' >"$TILED" 2>/dev/null || true
  # (Omarchy's mark on windows its floating workspaces floated: it goes when the
  # layouts are paused, and Omarchy re-tiles by it later)
  hyprctl clients -j | jq -c '[.[] | select((.tags // []) | map(rtrimstr("*")) | index("omarchy-mode-floated")) | .address]' >"$OMARCHY_FLOATED" 2>/dev/null || true
  touch "$FLAG" "$STATE_DIR/snap-request"
  echo on >"$STATE_DIR/mode"   # the plugins watch this (they don't poll the flag)
  # this look's theme and picked wallpaper; else a theme's animated
  # wallpaper stays, or the slideshow's picture
  if ! apply_look "$(style)"; then
    rm -f "$SLIDE_SHOWN"
    live_wallpaper_showing || refresh_wallpaper
  fi
  start_slideshow
  switch_copies on
  pause_floating_layouts
  float_all
  # Back to their sections and places from last time, once the bar has moved.
  setsid sh -c 'sleep 2; overtake relayout all' </dev/null >/dev/null 2>&1 &
  # GTK apps (Files etc.) drop their own close button; Overtake Mode's title bar has one.
  gsettings get org.gnome.desktop.wm.preferences button-layout >"$SAVED_GTK_BUTTONS" 2>/dev/null || true
  gsettings set org.gnome.desktop.wm.preferences button-layout 'appmenu:' 2>/dev/null || true
  hyprctl reload >/dev/null
  # (once more: on that reload Omarchy re-tiles windows it had floated for a
  # floating workspace, now paused)
  [[ -d $PAUSED_LAYOUTS ]] && float_all
  local mode
  mode=$(style)
  notify $'\uf0ec' "Overtake ${mode^} (Super+Ctrl+Shift+W: next mode)"
}

# A switch to Omarchy that stopped partway: killed, or run outside the desktop
# session, where windows, the theme and the wallpaper can't be put back. The
# marker keeps what's left to do, so `off` finishes it, `on` finishes it before
# saving anything as yours, and uninstall won't delete the saved values first.
SWITCHING_OFF="$STATE_DIR/switching-off"
OMARCHY_FLOATED="$STATE_DIR/omarchy-floated"
retag_floated() {
  local addr
  [[ -s $OMARCHY_FLOATED ]] || return 0
  hyprctl version >/dev/null 2>&1 || return 0   # (no session: kept for when there is one)
  for addr in $(jq -r '.[]? | select(type == "string" and test("^0x[0-9a-fA-F]+$"))' "$OMARCHY_FLOATED" 2>/dev/null); do
    hyprctl dispatch "hl.dsp.window.tag({ tag = \"+omarchy-mode-floated\", window = \"address:$addr\" })" >/dev/null 2>&1 || true
  done
  rm -f "$OMARCHY_FLOATED"
}
# Real `hyprctl --batch` exits 0 whatever a line answers, so a refused line is
# only visible in its reply. Said on stderr, and kept for a report (private folder).
batch_checked() {
  local reply refused
  reply=$(hyprctl --batch "$1" 2>&1) || true
  # (a warning is Hyprland doing what it can, a split with one window in it, say)
  refused=$(grep -v '^ok$' <<<"$reply" | grep -v '^[[:space:]]*$' | grep -v '^warning') || return 0
  printf '%s\n' "$refused" | head -20 >"$STATE_DIR/hyprland-refused.log" 2>/dev/null || true
  echo "overtake: Hyprland refused a step (see $STATE_DIR/hyprland-refused.log)" >&2
}
require_session() {
  hyprctl version >/dev/null 2>&1 || { echo "overtake: this needs your desktop session (no Hyprland here)" >&2; exit 1; }
}
finish_switch_off() {
  [[ -f $SWITCHING_OFF ]] || return 0
  turn_off
  [[ ! -f $SWITCHING_OFF ]] || exit 1
}

turn_off() {
  # (also when only the bar says so, or the marker: a switch that failed halfway)
  [[ -f $FLAG || -f $SWITCHING_OFF ]] || overtake_bar_showing || { echo "Overtake Mode is already off"; return; }
  require_shell_json
  local view
  view=$(current_view)
  # (finishing a switch that stopped partway: what's showing may be Omarchy's
  # by now, and the mode's was saved the first time)
  if [[ ! -f $SWITCHING_OFF ]]; then
    [[ $(style) == classic ]] && save_taskbar_settings
    save_look "$(style)"
  fi
  # The plugins first: the shell writes shell.json itself when it switches one,
  # from the copy it holds, which could put Overtake's bar back over a bar
  # written before it. (With no shell, the same step edits shell.json directly,
  # and leaves the bar for the lines below.)
  switch_copies off
  if [[ -s $SAVED_BAR ]] && jq -e '. == null' "$SAVED_BAR" >/dev/null 2>&1; then
    # you had no bar of your own in shell.json (Omarchy's built-in one): none again
    replace_with "$SHELL_JSON" jq 'del(.bar)' "$SHELL_JSON"
  elif [[ -s $SAVED_BAR ]] && jq -e 'type == "object"' "$SAVED_BAR" >/dev/null 2>&1; then
    set_bar "$(cat "$SAVED_BAR")"
    # Omarchy updated while the mode was on: its update adjusted Overtake's bar,
    # not this saved one
    if [[ -s $SAVED_BAR.omarchy && $(omarchy-version 2>/dev/null) != "$(<"$SAVED_BAR.omarchy")" ]]; then
      notify $'\uf071' "Omarchy was updated while Overtake Mode was on: your bar is as it was before the update (Appearance > Menu Bar to adjust it)"
    fi
    rm -f "$SAVED_BAR.omarchy"
  else
    # no saved bar (state removed?): none in shell.json, so Omarchy's default
    # one is used, and stays followed when Omarchy changes it
    replace_with "$SHELL_JSON" jq 'del(.bar)' "$SHELL_JSON"
    notify $'\uf071' "Overtake couldn't find your saved bar, so Omarchy's default bar is back"
  fi
  remove_bar_size
  resume_floating_layouts
  touch "$SWITCHING_OFF"
  rm -f "$FLAG" "$DESKTOP_RETURN"
  echo off >"$STATE_DIR/mode"
  # (each step on its own: one that fails doesn't stop the others)
  local unfinished=""
  hyprctl version >/dev/null 2>&1 || unfinished=1
  restore_all || unfinished=1
  tile_all || unfinished=1
  if [[ -s $SAVED_GTK_BUTTONS ]]; then
    if gsettings set org.gnome.desktop.wm.preferences button-layout "$(tr -d "'" <"$SAVED_GTK_BUTTONS")" 2>/dev/null; then
      rm -f "$SAVED_GTK_BUTTONS"
    else
      unfinished=1
    fi
  fi
  stop_slideshow || true
  # Omarchy's theme and wallpaper back (from before this version: the saved
  # wallpaper, if the slideshow replaced it)
  if ! apply_look omarchy && [[ -s $SAVED_BG && -f $(<"$SAVED_BG") && $(readlink -f "$CURRENT_BG") == "$HOME/Pictures/overtake/"* ]]; then
    set_background "$(<"$SAVED_BG")" || true
  fi
  hyprctl reload >/dev/null 2>&1 || true
  retag_floated
  # Tiling the windows again moves focus from workspace to workspace: end
  # where you were.
  [[ -z $view ]] || batch_checked "$view"
  rm -f "$STATE_DIR/.ws-name.$$."*   # (the view's)
  # (and any a failed dispatch left behind, old enough not to be in use)
  find "$STATE_DIR" -maxdepth 1 -name '.ws-name.*' -mmin +1 -delete 2>/dev/null || true
  if [[ $unfinished ]]; then
    echo "overtake: switched off as far as it can from here; run \`overtake off\` in your desktop session to finish" >&2
    return 1
  fi
  rm -f "$SWITCHING_OFF"
  notify $'\uf0ec' "Omarchy (Super+Ctrl+Shift+W: next mode)"
}

# The workspace each screen shows and the focused window, as hyprctl --batch
# commands that bring them back (the focused screen's workspace last).
current_view() {
  local mon ws focused last="" cmds="" active lua
  # (\u0001, not @tsv: that spells a backslash in a workspace's name as two)
  while IFS=$'\001' read -r mon ws focused; do
    [[ $ws != special:* ]] && lua=$(ws_lua "$ws") || continue
    if [[ $focused == true ]]; then
      last="dispatch hl.dsp.focus({ workspace = $lua })"
    else
      cmds+="dispatch hl.dsp.focus({ workspace = $lua }) ; "
    fi
  done < <(hyprctl monitors -j | jq -r '.[] | [.name, .activeWorkspace.name, (.focused | tostring)] | join("\u0001")')
  active=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')
  [[ $active =~ ^0x[0-9a-f]+$ ]] || active=""
  cmds+=$last
  [[ -n $active ]] && cmds+=" ; dispatch hl.dsp.focus({ window = \"address:$active\" })"
  [[ -n $cmds ]] && echo "eval hl.config({ cursor = { no_warps = true } }) ; $cmds ; eval hl.config({ cursor = { no_warps = $(warps_setting) } })"
  return 0
}

# Super+Ctrl+Shift+W: the next desktop mode, round and round:
# Omarchy -> Overtake Classic -> Overtake Studio -> Omarchy.
MODES=(omarchy classic studio)
cycle_mode() {
  local current i next=omarchy
  require_shell_json
  current=$(current_mode)
  for i in "${!MODES[@]}"; do
    [[ ${MODES[$i]} == "$current" ]] && next=${MODES[$(( (i + 1) % ${#MODES[@]} ))]}
  done
  if [[ $next == omarchy ]]; then
    turn_off
  elif [[ -f $FLAG ]]; then
    set_style "$next"
  else
    mkdir -p "$(dirname "$STYLE_FILE")"
    echo "$next" >"$STYLE_FILE"
    turn_on
  fi
}

# Window controls. Minimized windows wait on the hidden special:minimized
# workspace; minimized.json remembers where each one came from.
warps_setting() {  # your cursor:no_warps (true/false), put back after Overtake's moves pause it
  hyprctl getoption cursor:no_warps -j 2>/dev/null | jq -r 'if has("bool") then .bool else (.int != 0) end' 2>/dev/null || echo false
}

lua_safe() {  # a name that can sit inside a "..." Lua string as it is, and in
  # a `hyprctl --batch` line (which splits on ";")
  [[ $1 != *[\"\\\;]* && $1 != *[[:cntrl:]]* ]]
}

# A workspace, as the Lua that `hyprctl dispatch` runs. A number as it is. A
# named one can only be reached by name (a negative id counts as relative, a bare
# name is "Bad workspace"), and a name you gave it is private: the Lua reads it
# from a file in the state folder, so it's neither in a command line nor read
# as code.
ws_lua() {  # ws_lua <workspace name>
  if [[ $1 =~ ^[0-9]+$ ]]; then printf '"%s"' "$1"; return 0; fi
  lua_safe "$STATE_DIR" || return 1
  local file
  file=$(mktemp "$STATE_DIR/.ws-name.$$.XXXXXX") || return 1
  printf '%s' "$1" >"$file" || return 1
  printf '"name:" .. io.open("%s"):read("a")' "$file"
}
ws_lua_done() {  # ws_lua_done <that Lua>: its file, once the dispatch has run
  if [[ $1 =~ io\.open\(\"([^\"]+)\"\) ]]; then rm -f "${BASH_REMATCH[1]}"; fi
}

window_address() {
  if [[ -n ${1:-} ]]; then echo "$1"; else hyprctl activewindow -j | jq -r '.address // empty'; fi
}

window_workspace() {
  hyprctl clients -j | jq -r --arg a "$1" '.[] | select(.address == $a) | .workspace.name'
}

minimize_window() {
  local addr ws
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] || return 0
  ws=$(window_workspace "$addr")
  [[ -n $ws && $ws != special:* ]] || return 0
  json_set "$MINIMIZED" '.[$a] = $w' --arg a "$addr" --rawfile w <(printf '%s' "$ws")
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:minimized\", follow = false, window = \"address:$addr\" })" >/dev/null
}

# $2 = "follow" to switch to the window's workspace and focus it.
restore_window() {
  local addr=$1 follow=${2:-follow} ws="" lua
  # Back to the workspace it was minimized from (or, failing that, the last
  # one the layout record saw it on), not the one being looked at.
  [[ -s $MINIMIZED ]] && ws=$(jq -r --arg a "$addr" '.[$a] // empty' "$MINIMIZED")
  [[ -n $ws || ! -s $LAYOUT ]] || ws=$(jq -r --arg a "$addr" '.[$a].ws // empty' "$LAYOUT")
  [[ -n $ws ]] || ws=$(hyprctl activeworkspace -j | jq -r '.name')
  lua=$(ws_lua "$ws") || return 0
  if [[ $follow == follow ]]; then
    hyprctl dispatch "hl.dsp.window.move({ workspace = $lua, follow = true, window = \"address:$addr\" })" >/dev/null
    focus_raise "$addr"
  else
    hyprctl dispatch "hl.dsp.window.move({ workspace = $lua, follow = false, window = \"address:$addr\" })" >/dev/null
  fi
  ws_lua_done "$lua"
  [[ -s $MINIMIZED ]] && json_set "$MINIMIZED" 'del(.[$a])' --arg a "$addr"
  bring_into_view "$addr"
}

# A floating window keeps its position when a screen goes away (closing the
# lid, undocking), so it can end up where no screen shows it. Move such a
# window to the middle of its monitor, shrunk to fit if it's too big.
# Room for the title bar: a floating window whose top is too close to the top
# of its screen (one that opens full height, like Tensaku) moves down so the
# title bar sits above it instead of over its own toolbar, and is shortened
# if it would then run past the bottom.
make_room() {
  local addr=$1 info x y w h top bottom want newh
  info=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  [[ -n $info && $(jq -r '.floating and .fullscreen == 0' <<<"$info") == true ]] || return 0
  read -r top bottom < <(hyprctl monitors -j | jq -r --argjson id "$(jq .monitor <<<"$info")" \
    '.[] | select(.id == $id) | "\(.y + .reserved[1]) \(.y + (.height / .scale | floor) - .reserved[3])"')
  [[ -n ${bottom:-} ]] || return 0   # (the monitor just went away)
  read -r x y w h < <(jq -r '.at + .size | map(floor) | join(" ")' <<<"$info")
  want=$((top + SNAP_TITLE_BAR))
  (( y < want )) || return 0
  newh=$h
  (( want + h > bottom )) && newh=$((bottom - want))
  mark_arranging
  (( newh != h )) && hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $newh, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $want, relative = false, window = \"address:$addr\" })" >/dev/null
}

bring_into_view() {
  local addr=$1 info monitors
  info=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  [[ -n $info ]] || return 0
  [[ $(jq -r '.floating and .fullscreen == 0 and (.workspace.name | startswith("special:") | not)' <<<"$info") == true ]] || return 0
  monitors=$(hyprctl monitors -j)
  # Visible enough: at least 120x48 of it on some screen.
  jq -e --slurpfile w <(printf '%s' "$info") '$w[0] as $w | any(.[];
      ([$w.at[0] + $w.size[0], .x + .width / .scale] | min) - ([$w.at[0], .x] | max) >= 120 and
      ([$w.at[1] + $w.size[1], .y + .height / .scale] | min) - ([$w.at[1], .y] | max) >= 48)' \
    <<<"$monitors" >/dev/null && return 0

  local mx my mw mh rl rt rr rb
  read -r mx my mw mh rl rt rr rb < <(jq -r --argjson id "$(jq .monitor <<<"$info")" \
    '(map(select(.id == $id)) + map(select(.focused)) + .)[0]
     | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor) \(.reserved | join(" "))"' <<<"$monitors")
  local uw=$((mw - rl - rr)) uh=$((mh - rt - rb - SNAP_TITLE_BAR))
  local w h
  w=$(jq .size[0] <<<"$info") h=$(jq .size[1] <<<"$info")
  (( w > uw * 9 / 10 )) && w=$((uw * 9 / 10))
  (( h > uh * 9 / 10 )) && h=$((uh * 9 / 10))
  local x=$((mx + rl + (uw - w) / 2)) y=$((my + rt + SNAP_TITLE_BAR + (uh - h) / 2))
  hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$addr\" })" >/dev/null
}

# Screens coming and going (dock, lid) leave floating windows at their old
# absolute positions. `remember` (run every few seconds by the taskbar plugin)
# records each window's place as fractions of its screen's usable area;
# `relayout` (run after a screen change) puts snapped windows back in their
# zone and the rest at the same fractions of the screen they're on now.
USABLE_JQ='def usable: {name, x: (.x + .reserved[0]), y: (.y + .reserved[1]),
  w: ((.width / .scale | floor) - .reserved[0] - .reserved[2]),
  h: ((.height / .scale | floor) - .reserved[1] - .reserved[3])};'

remember_layout() {
  local clients monitors
  clients=$(hyprctl clients -j) monitors=$(hyprctl monitors -j)
  # Only windows whose centre is on their own screen (skips ones a screen change
  # has just stranded), merged over the old records; closed windows dropped.
  json_set "$LAYOUT" "$USABLE_JQ"'
    $clients[0] as $clients | $monitors[0] as $monitors
    | ($monitors | map({key: (.id | tostring), value: usable}) | from_entries) as $m
    | ([$clients[] | .address]) as $live
    | (with_entries(select(.key as $k | $live | index($k))))
      + ([$clients[] | select(.floating and .fullscreen == 0 and .workspace.id > 0)
          | . as $c | $m[(.monitor | tostring)] as $u | select($u != null)
          | (.at[0] + .size[0] / 2) as $cx | (.at[1] + .size[1] / 2) as $cy
          | select($cx >= $u.x and $cx < $u.x + $u.w and $cy >= $u.y and $cy < $u.y + $u.h)
          | {key: .address, value: {mon: $u.name, uw: $u.w, uh: $u.h, ws: $c.workspace.name,
              fx: (($c.at[0] - $u.x) / $u.w), fy: (($c.at[1] - $u.y) / $u.h),
              fw: ($c.size[0] / $u.w), fh: ($c.size[1] / $u.h)}}] | from_entries)
  ' --slurpfile clients <(printf '%s' "$clients") --slurpfile monitors <(printf '%s' "$monitors")
}

# relayout [all]: "all" puts every recorded window back (used by `on`, when
# windows come back from tiling), not just the ones on a changed screen.
relayout() {
  local clients monitors addr zone cmds all=false
  mark_arranging
  [[ ${1:-} == all ]] && all=true
  clients=$(hyprctl clients -j) monitors=$(hyprctl monitors -j)
  # Snapped windows: back into their zone on whatever screen they're on now.
  if [[ -s $ZONES ]]; then
    while read -r addr zone; do
      [[ -n $addr ]] && SNAP_NO_FOCUS=1 snap_window "$zone" "$addr"
    done < <(jq -r --slurpfile clients <(printf '%s' "$clients") '
      $clients[0] as $clients | to_entries[] | .key as $a | select(any($clients[]; .address == $a and .floating and .fullscreen == 0 and .workspace.id > 0))
      | "\(.key) \(.value.zone)"' "$ZONES")
  fi
  # Everything else: same fractions of its current screen, if that screen is a
  # different one (or a different size) from when it was recorded. Any window
  # is then kept inside its screen (shrunk if it's bigger).
  [[ -s $LAYOUT ]] || echo '{}' >"$LAYOUT"
  cmds=$(jq -r --argjson all "$all" --slurpfile clients <(printf '%s' "$clients") --slurpfile monitors <(printf '%s' "$monitors") --slurpfile zones <(cat "$ZONES" 2>/dev/null || echo '{}') "$USABLE_JQ"'
    $clients[0] as $clients | $monitors[0] as $monitors
    | ($monitors | map({key: (.id | tostring), value: usable}) | from_entries) as $m
    | . as $rec
    | $clients[] | select(.floating and .fullscreen == 0 and .workspace.id > 0)
    | select(($zones[0] // {})[.address] == null)
    | $m[(.monitor | tostring)] as $u | select($u != null)
    | ($rec[.address] // null) as $r
    | ($r != null and ($all or $r.mon != $u.name or $r.uw != $u.w or $r.uh != $u.h)) as $moved
    | (if $moved then [$r.fx * $u.w + $u.x, $r.fy * $u.h + $u.y, $r.fw * $u.w, $r.fh * $u.h]
       else [.at[0], .at[1], .size[0], .size[1]] end | map(floor)) as $g
    | ([[$g[2], $u.w] | min, 200] | max) as $w | ([[$g[3], $u.h] | min, 120] | max) as $h
    | ([[$g[0], $u.x + $u.w - $w] | min, $u.x] | max) as $x | ([[$g[1], $u.y + $u.h - $h] | min, $u.y] | max) as $y
    | select($moved or $w != .size[0] or $h != .size[1] or $x != .at[0] or $y != .at[1])
    | "dispatch hl.dsp.window.resize({ x = \($w), y = \($h), relative = false, window = \"address:\(.address)\" }) ; " +
      "dispatch hl.dsp.window.move({ x = \($x), y = \($y), relative = false, window = \"address:\(.address)\" })"
  ' "$LAYOUT" | paste -sd ';')
  [[ -z $cmds ]] || hyprctl --batch "$cmds" >/dev/null
  rescue_all
  unstick_workspaces
  remember_layout
}

# A screen leaving mid-animation (lid closing as the dock comes up) can freeze a
# workspace's slide part-way: its windows are drawn a whole screen-width off to
# one side while their title bars stay put. Hyprland lists that as "workspace
# offset" long after any real animation has ended; leaving the workspace and
# coming back redraws it in place.
unstick_workspaces() {
  local ws
  # (by number only: a named workspace's negative id would count as relative)
  for ws in $(hyprctl monitors | awk '
      /^Monitor /                      { ws = "" }
      /^\tactive workspace: /          { ws = $3 }
      /^\tsolitaryBlockedBy: .*workspace offset/ && ws ~ /^[0-9]+$/ { print ws }'); do
    hyprctl --batch "eval hl.config({ cursor = { no_warps = true } }) ; dispatch hl.dsp.focus({ workspace = \"empty\" }) ; dispatch hl.dsp.focus({ workspace = \"$ws\" }) ; eval hl.config({ cursor = { no_warps = $(warps_setting) } })" >/dev/null
  done
}

rescue_all() {
  local addr
  mark_arranging
  for addr in $(hyprctl clients -j | jq -r '.[] | select(.floating and (.workspace.name | startswith("special:") | not)) | .address'); do
    bring_into_view "$addr"
  done
}

# Taskbar click or title-bar tab: bring the window back on screen if needed,
# then focus it (switching to its workspace).
# Raise it too: focus alone leaves a floating window under the one covering it,
# and focus-follows-mouse then hands focus straight back to the top one.
show_window() {
  bring_into_view "$1"
  focus_raise "$1"
}

# Focus and raise without moving the mouse (Hyprland normally warps the cursor
# to the window it focuses; a click shouldn't move the pointer).
focus_raise() {
  hyprctl --batch "eval hl.config({ cursor = { no_warps = true } }) ; dispatch hl.dsp.focus({ window = \"address:$1\" }) ; dispatch hl.dsp.window.bring_to_top() ; eval hl.config({ cursor = { no_warps = $(warps_setting) } })" >/dev/null
}

# Hyprland shows a special workspace when something focuses a window on it
# (focus returning to a minimized window after a menu closes, an app asking to
# be activated). Minimized windows have no title bar and can't be minimized
# again from there, so hide it straight away; the taskbar restores them.
hide_minimized() {
  local mon
  for mon in $(hyprctl monitors -j | jq -r '.[] | select(.specialWorkspace.name == "special:minimized") | .name'); do
    lua_safe "$mon" || continue
    hyprctl --batch "dispatch hl.dsp.focus({ monitor = \"$mon\" }) ; dispatch hl.dsp.workspace.toggle_special(\"minimized\")" >/dev/null
  done
}

# Go to an app's window where it lives (the notification center's click):
# matched by class like omarchy-hyprland-focus-app, the most recently used
# window first. A minimized one is restored to the workspace it came from and
# followed there; any other is reached by switching to its workspace.
focus_app() {  # focus_app <app> [exact|agent]: its most recent window (class contains the name, is it, or an agent terminal's title has it)
  local info addr ws lua
  # (the name through the environment: other accounts can't read that)
  info=$(hyprctl clients -j | OVERTAKE_APP=$1 jq -c --arg how "${2:-}" '
    (env.OVERTAKE_APP | ascii_downcase) as $q
    | sort_by(.focusHistoryID)
    | first(.[] | select(if $how == "agent" then .initialClass == "org.omarchy.agent" and ((.initialTitle // "") | ascii_downcase | contains($q)) else [(.class // ""), (.initialClass // "")] | any(ascii_downcase | if $how == "" then contains($q) else . == $q end) end)) // empty')
  [[ -n $info ]] || return 1
  addr=$(jq -r .address <<<"$info") ws=$(jq -r .workspace.name <<<"$info")
  if [[ $ws == special:minimized ]]; then
    restore_window "$addr" follow
  else
    if [[ $ws != special:* ]] && lua=$(ws_lua "$ws"); then
      hyprctl dispatch "hl.dsp.focus({ workspace = $lua })" >/dev/null
      ws_lua_done "$lua"
    fi
    focus_raise "$addr"
  fi
}

# A notification clicked in the notification center that carries no action of
# its own: bring the sending app's open window forward, as Omarchy's own toasts
# do (omarchy-hyprland-focus-app). Nothing is opened or launched from the
# notification's text. Exit 1 when the app has no open window.
notification_open() {
  local app=""
  # (a sender chooses this name: it comes on stdin, never as an argument)
  IFS= read -r -t 5 -n 4096 app || true
  [[ -n $app ]] || return 1
  # (agent terminals share a class, with the terminal's name only in their first title)
  focus_app "$app" exact || focus_app "$app" || focus_app "$app" agent
}

# Clicking empty desktop: minimize every window on the workspace that screen
# shows (the focused screen's when none is given).
minimize_all() {
  local ws addr
  if [[ -n ${1:-} ]]; then
    ws=$(hyprctl monitors -j | jq -r --arg m "$1" '.[] | select(.name == $m) | .activeWorkspace.name')
  else
    ws=$(hyprctl activeworkspace -j | jq -r '.name')
  fi
  [[ -n $ws && $ws != special:* ]] || return 0
  for addr in $(hyprctl clients -j | jq -r --rawfile w <(printf '%s' "$ws") '.[] | select(.workspace.name == $w) | .address'); do
    minimize_window "$addr"
  done
}

# Screensaver settings, using Omarchy's own pieces: the screensaver-off toggle,
# the idle timeouts in shell.json (seconds; 0 = never), and the art in
# ~/.config/omarchy/branding/screensaver.txt.
SCREENSAVER_ART="$HOME/.config/omarchy/branding/screensaver.txt"
# What you had is kept once, before Overtake first replaces it, whatever it
# was (uninstall.sh puts it back): the copy made whole first, so a full disk
# can't leave half of it, and stops the replacement. No art at all is noted too.
keep_screensaver_art() {
  local tmp
  [[ ! -e $SCREENSAVER_ART.before-overtake && ! -e $STATE_DIR/screensaver-art-absent ]] || return 0
  mkdir -p "$(dirname "$SCREENSAVER_ART")"
  if [[ ! -e $SCREENSAVER_ART ]]; then touch "$STATE_DIR/screensaver-art-absent"; return; fi
  tmp=$(mktemp "$SCREENSAVER_ART.XXXXXX") || return 1
  if cp -p "$SCREENSAVER_ART" "$tmp" && mv -f "$tmp" "$SCREENSAVER_ART.before-overtake"; then return 0; fi
  rm -f "$tmp"
  return 1
}
# What Overtake itself put there: anything else (written in the editor, picked
# through Omarchy, or changed later) is yours, and uninstall leaves it in place.
note_art_written() { sha256sum <"$SCREENSAVER_ART" >"$STATE_DIR/screensaver-art-written"; }
screensaver_cmd() {
  case "${1:-}" in
    on) omarchy-toggle-enabled screensaver-off && omarchy-toggle screensaver-off >/dev/null; true ;;
    off) omarchy-toggle-enabled screensaver-off || omarchy-toggle screensaver-off >/dev/null; true ;;
    enabled) ! omarchy-toggle-enabled screensaver-off ;;
    start|lock)
      local key=screensaver tmp
      [[ $1 == lock ]] && key=lock
      require_shell_json
      if [[ -z ${2:-} ]]; then jq -r --arg k "$key" '.idle[$k] // (if $k == "lock" then 300 else 150 end)' "$SHELL_JSON"; return; fi
      [[ $2 =~ ^[0-9]+$ ]] || { echo "seconds, please" >&2; return 1; }
      replace_with "$SHELL_JSON" jq --arg k "$key" --argjson v "$2" '.idle[$k] = $v' "$SHELL_JSON"
      omarchy-shell shell reloadConfig >/dev/null 2>&1 || true ;;
    show)
      local omarchy="${OMARCHY_PATH:-/usr/share/omarchy}"
      case "${2:-}" in
        omarchy|text|image|wallpaper) keep_screensaver_art || return 1 ;;
      esac
      case "${2:-}" in
        omarchy) cp "$omarchy/logo.txt" "$SCREENSAVER_ART"; note_art_written ;;
        text) omarchy-launch-editor "$SCREENSAVER_ART" >/dev/null 2>&1; return ;;
        image) omarchy-branding-screensaver image; return ;;
        wallpaper)
          # The art is drawn in dots on black: a dark (night) wallpaper is
          # flipped first so its lights become the dots, a bright one keeps its
          # dark shapes as the dots.
          local bg tmp mean
          bg=$(readlink -f "$CURRENT_BG")
          mkdir -p -m 700 "$STATE_DIR"
          tmp=$(mktemp "$STATE_DIR/screensaver.XXXXXX.png")
          # (the picture on stdin: its name stays out of the command lines)
          mean=$(magick - -colorspace gray -format '%[fx:mean < 0.4 ? 1 : 0]' info: <"$bg" 2>/dev/null || echo 0)
          if [[ $mean == 1 ]]; then magick - -negate "$tmp" <"$bg"; else cat <"$bg" >"$tmp"; fi
          omarchy-transcode-ascii "$tmp" "$SCREENSAVER_ART" >/dev/null || { rm -f "$tmp"; return 1; }
          rm -f "$tmp"; note_art_written ;;
        *) echo "show omarchy|text|image|wallpaper" >&2; return 1 ;;
      esac
      omarchy-launch-screensaver force >/dev/null 2>&1 & ;;
    showing)
      if cmp -s "$SCREENSAVER_ART" "${OMARCHY_PATH:-/usr/share/omarchy}/logo.txt"; then echo "Omarchy logo"; else echo "Your own"; fi ;;
    preview) omarchy-launch-screensaver force >/dev/null 2>&1 & ;;
    *) echo "overtake screensaver on|off|enabled|start [s]|lock [s]|show <omarchy|text|image|wallpaper>|showing|preview" >&2; return 1 ;;
  esac
}

restore_all() {
  local addr
  for addr in $(hyprctl clients -j | jq -r '.[] | select(.workspace.name == "special:minimized") | .address'); do
    restore_window "$addr" stay
  done
}

maximize_window() {
  local addr
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] && hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"maximized\", window = \"address:$addr\" })" >/dev/null
  return 0
}

close_window() {
  local addr
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] && hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null
  return 0
}

# ---------- Floating and snap layouts ----------
# A browser window's page address, to the clipboard. Nothing outside the
# browser can ask it for the page it shows, but it keeps every page it visits
# (address and title) in its History database, and the window's title is the
# page's title: so the newest visit with that title. Chromium-family browsers
# (Omarchy's web apps run in one).
copy_url() {
  local addr=$1 class title dir url
  read -r class < <(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address == $a) | .class')
  title=$(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address == $a) | .title')
  case $class in
    chromium | chrome-*) dir="$HOME/.config/chromium" ;;
    google-chrome*) dir="$HOME/.config/google-chrome" ;;
    brave*) dir="$HOME/.config/BraveSoftware/Brave-Browser" ;;
    *) notify $'\uf0c5' "Copy URL works with Chromium, Chrome, Brave and Omarchy's web apps"; return 0 ;;
  esac
  # the page title through the environment, not the process list
  url=$(OVERTAKE_TITLE=$title python3 -I - "$dir" <<'PY'
import glob, os, sqlite3, sys, urllib.parse
root, title = sys.argv[1], os.environ.get("OVERTAKE_TITLE", "")
for suffix in (" - Chromium", " - Google Chrome", " - Brave"):
    if title.endswith(suffix): title = title[: -len(suffix)]
best = None
for db in glob.glob(os.path.join(root, "*", "History")):
    # read-only and immutable: the browser keeps the database locked, and
    # this reads it in place instead of copying it anywhere
    try:
        con = sqlite3.connect("file:" + urllib.parse.quote(db) + "?mode=ro&immutable=1", uri=True)
        row = con.execute(
            "select url, last_visit_time from urls where title = ? order by last_visit_time desc limit 1", (title,)).fetchone()
        con.close()
    except sqlite3.Error:
        continue
    if row and (best is None or row[1] > best[1]): best = row
print(best[0] if best else "")
PY
)
  if [[ -n $url ]]; then
    printf '%s' "$url" | wl-copy
    notify $'\uf0c5' "Copied the newest address with this page's title"
  else
    notify $'\uf0c5' "Couldn't find this page's address yet (try again in a few seconds)"
  fi
}

# The taskbar to the start of a bar section, the way Omarchy's own bar
# commands edit the layout: shell.json, then a config reload.
taskbar_position() {
  local config="$HOME/.config/omarchy/shell.json"
  [[ $1 == left || $1 == center ]] || { echo "overtake: taskbar-position takes left or center" >&2; return 1; }
  [[ -s $config ]] || return 0
  json_set "$config" '
    ([.bar.layout // {} | to_entries[] | .value | arrays | .[] | select(.id? == "overtake.taskbar")][0] // {id: "overtake.taskbar"}) as $entry
    | .bar.layout |= ((. // {}) | with_entries(if (.value | type) == "array" then .value |= map(select(.id? != "overtake.taskbar")) else . end))
    | .bar.layout[$to] = [$entry] + (.bar.layout[$to] // [])
  ' --arg to "$1"
  omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
}

# Several overtake processes can write the same state file at once (quick
# clicks, the taskbar's periodic `remember`), so writes take a lock and their
# own temp file, and an empty result never replaces the file.
json_set() {  # json_set <file> <jq filter> [jq args...]
  local file=$1 filter=$2
  shift 2
  mkdir -p -m 700 "$STATE_DIR"
  (
    flock 9
    [[ -s $file ]] || echo '{}' >"$file"
    # (through replace_with: a symlinked file keeps its link, and its mode)
    replace_with "$file" jq "$@" "$filter" "$file" || true
  ) 9>"$STATE_DIR/.lock"
}

# Window names (title bar Rename tab, taskbar Rename window) live in
# names.json as address -> name; a name goes with its window.
NAMES="$STATE_DIR/names.json"

window_here() {  # the window this command runs in: walk up the process tree to a window's process
  local windows pid=$$ i
  windows=$(hyprctl clients -j | jq -c 'map({key: (.pid | tostring), value: .address}) | from_entries')
  for i in $(seq 30); do
    jq -e --arg p "$pid" '.[$p]' <<<"$windows" >/dev/null && { jq -r --arg p "$pid" '.[$p]' <<<"$windows"; return; }
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [[ -n $pid && $pid != 0 && $pid != 1 ]] || return 0
  done
}

set_name() {  # set_name <address> [name]; an empty name clears it
  local addr=$1 name=${2:-} live
  name=${name//$'\n'/ }
  name=${name#"${name%%[![:space:]]*}"}
  name=${name%"${name##*[![:space:]]}"}
  name=${name:0:80}
  live=$(hyprctl clients -j | jq -c 'map(.address)')
  json_set "$NAMES" 'with_entries(select(.key as $k | $live | any(. == $k))) | if $n == "" then del(.[$a]) else .[$a] = $n end' \
    --arg a "$addr" --rawfile n <(printf '%s' "$name") --argjson live "$live"
}

float_all() {
  local addr
  mark_arranging
  for addr in $(hyprctl clients -j | jq -r '.[] | select(.workspace.id > 0 and .floating == false) | .address'); do
    hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"address:$addr\" })" >/dev/null || true
  done
}

# Back to tiling for `off`: every floating window on a normal workspace except
# the ones that were already floating before `on` (dialogs, pickers, ones you
# floated yourself). Windows opened while the mode was on float by its rule,
# so a list of "windows the mode floated" would miss them.
tile_all() {
  local addr keep='[]'
  hyprctl version >/dev/null 2>&1 || return 1   # (no session: kept for when there is one)
  [[ -s $KEEP_FLOATING ]] && keep=$(<"$KEEP_FLOATING")
  retile_saved "$keep"
  for addr in $(hyprctl clients -j | jq -r --argjson keep "$keep" \
      '.[] | select(.workspace.id > 0 and .floating and (.address as $a | $keep | index($a) | not)) | .address'); do
    hyprctl dispatch "hl.dsp.window.float({ action = \"disable\", window = \"address:$addr\" })" >/dev/null 2>&1 || true
  done
  # Zones are kept: `on` puts snapped windows back in them.
  rm -f "$KEEP_FLOATING" "$TILED"
}

# Put the windows that were tiled before `on` back in the same tiles. Tiling
# them one by one in any order lets Hyprland's dwindle layout split them its
# own way, so three windows stacked on the left come back as three columns.
# Instead rebuild each workspace's split tree: find the cut through the saved
# places, tile one window from each side with the split direction preselected,
# set the ratio, and repeat inside each side.
retile_saved() {  # retile_saved <kept-floating json>
  [[ -s $TILED ]] || return 0
  local active cmds view here anim
  active=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty') || active=""
  view=$(current_view) || view=""
  here=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // 0') || here=0   # (off's `tile_all || ...` also carries on; `relayout` needs these)
  cmds=$(python3 -I - "$TILED" "$1" "$here" <<'PY'
import json, subprocess, sys

saved = json.load(open(sys.argv[1]))
keep = set(json.loads(sys.argv[2]))
# (read here rather than passed in: window titles stay out of the process list)
try:
    live = {c["address"]: c for c in json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)}
except ValueError:  # (no session: what's left is finished from inside one)
    sys.exit(1)
layouts = {}
try:
    layouts = {w["id"]: w.get("tiledLayout") for w in json.loads(subprocess.run(["hyprctl", "workspaces", "-j"], capture_output=True, text=True).stdout)}
except ValueError:
    pass
GAP = 30  # px: wider than any gap between tiles, narrower than a window

def box(w):
    x, y = w["at"]; cw, ch = w["size"]
    return x, y, x + cw, y + ch

def cut(wins):  # -> (axis, first side, second side), or None
    for axis in (0, 1):
        for c in sorted({box(w)[axis + 2] for w in wins}):
            a = [w for w in wins if box(w)[axis + 2] <= c + GAP / 2]
            b = [w for w in wins if box(w)[axis] >= c - GAP / 2]
            if a and b and len(a) + len(b) == len(wins):
                return axis, a, b
    return None

def extent(wins, axis):
    return max(box(w)[axis + 2] for w in wins) - min(box(w)[axis] for w in wins)

def first(wins):
    return min(wins, key=lambda w: (box(w)[1], box(w)[0]))["address"]

out = []
def focus(a): out.append(f'dispatch hl.dsp.focus({{ window = "address:{a}" }})')
def tile(a): out.append(f'dispatch hl.dsp.window.float({{ action = "disable", window = "address:{a}" }})')
def layout(m): out.append(f'dispatch hl.dsp.layout("{m}")')

def build(wins, leaf):  # leaf: the window of wins already tiled, filling their space
    if len(wins) < 2:
        return
    split = cut(wins)
    if not split:  # not a tiling dwindle could have made: tile the rest as they come
        for w in wins:
            if w["address"] != leaf:
                tile(w["address"])
        return
    axis, a, b = split
    leaf_in_a = any(w["address"] == leaf for w in a)
    new = first(b if leaf_in_a else a)
    focus(leaf)
    layout("preselect " + ("rd" if leaf_in_a else "lu")[axis])
    tile(new)
    ea, eb = extent(a, axis), extent(b, axis)
    focus(leaf)
    layout(f"splitratio {2 * ea / (ea + eb):.3f} exact")
    build(a, leaf if leaf_in_a else new)
    build(b, new if leaf_in_a else leaf)

# the workspace on screen last, so focus ends where it started
here = int(sys.argv[3]) if sys.argv[3].lstrip("-").isdigit() else 0
for ws in sorted({w["ws"] for w in saved}, key=lambda ws: (ws == here, ws)):
    wins = [w for w in saved if w["ws"] == ws and w["address"] in live
            and live[w["address"]]["floating"] and live[w["address"]]["workspace"]["id"] == ws
            and w["address"] not in keep]
    if not wins:
        continue
    if layouts.get(ws) not in (None, "dwindle"):  # (no split to rebuild there)
        for w in wins:
            tile(w["address"])
        continue
    root = first(wins)
    focus(root)
    tile(root)
    build(wins, root)
print(" ; ".join(out))
PY
) || return 0
  [[ -n $cmds ]] || return 0
  mark_arranging
  # One batch, with animations paused and your view put back at its end, so
  # the visits to other workspaces don't show.
  anim=$(hyprctl getoption animations:enabled -j 2>/dev/null | jq -r 'if has("bool") then .bool else (.int != 0) end')
  [[ $anim == true || $anim == 1 ]] && anim=true || anim=false
  batch_checked "eval hl.config({ animations = { enabled = false } }) ; eval hl.config({ cursor = { no_warps = true } }) ; $cmds${view:+ ; $view} ; eval hl.config({ cursor = { no_warps = $(warps_setting) } }) ; eval hl.config({ animations = { enabled = $anim } })"
}

# Overtake is about to move windows itself. The title-bar plugin watches the
# focused window for drags an app makes on its own; this stamp tells it to
# ignore movement for a moment, so our own arranging isn't taken for a drag
# out of a zone (which would unsnap it).
mark_arranging() {
  mkdir -p -m 700 "$STATE_DIR"
  date +%s%N >"$STATE_DIR/arranging"
}

snap_window() {
  local zone=$1 addr info ws mon count
  addr=$(window_address "${2:-}")
  [[ -n $addr ]] || return 0
  info=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  [[ -n $info ]] || return 0
  ws=$(jq -r .workspace.name <<<"$info")
  mon=$(jq -r .monitor <<<"$info")
  mkdir -p -m 700 "$STATE_DIR"

  # Forget windows that have closed, then respect the per-zone stack limit.
  json_set "$ZONES" 'with_entries(select(.key as $k | $live | index($k)))' \
    --argjson live "$(hyprctl clients -j | jq '[.[].address]')"
  count=$(jq --rawfile ws <(printf '%s' "$ws") --arg z "$zone" --arg a "$addr" \
    '[to_entries[] | select(.value.ws == $ws and .value.zone == $z and .key != $a)] | length' "$ZONES")
  if (( count >= SNAP_STACK_MAX )); then
    notify $'' "That spot already has $SNAP_STACK_MAX windows"
    return 0
  fi

  # Usable area of the window's monitor (logical pixels, minus the taskbar).
  local mx my mw mh rl rt rr rb
  read -r mx my mw mh rl rt rr rb < <(hyprctl monitors -j | jq -r --argjson id "$mon" \
    '.[] | select(.id == $id) | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor) \(.reserved | join(" "))"')
  [[ -n ${rb:-} ]] || return 0   # (the monitor just went away)
  local ux=$((mx + rl + SNAP_GAP)) uy=$((my + rt + SNAP_GAP))
  local uw=$((mw - rl - rr - 2 * SNAP_GAP)) uh=$((mh - rt - rb - 2 * SNAP_GAP))
  local hw=$(((uw - SNAP_GAP) / 2)) hh=$(((uh - SNAP_GAP) / 2))
  local x y w h
  case "$zone" in
    left) x=$ux y=$uy w=$hw h=$uh ;;
    right) x=$((ux + hw + SNAP_GAP)) y=$uy w=$hw h=$uh ;;
    top-left) x=$ux y=$uy w=$hw h=$hh ;;
    top-right) x=$((ux + hw + SNAP_GAP)) y=$uy w=$hw h=$hh ;;
    bottom-left) x=$ux y=$((uy + hh + SNAP_GAP)) w=$hw h=$hh ;;
    bottom-right) x=$((ux + hw + SNAP_GAP)) y=$((uy + hh + SNAP_GAP)) w=$hw h=$hh ;;
    full | fill) zone=full x=$ux y=$uy w=$uw h=$uh ;;
    center)
      # Studio's Center: the size it has (no bigger than the screen), in the middle.
      read -r w h < <(jq -r '.size | map(floor) | join(" ")' <<<"$info")
      (( w > uw )) && w=$uw
      (( h > uh - SNAP_TITLE_BAR )) && h=$((uh - SNAP_TITLE_BAR))
      x=$((ux + (uw - w) / 2)) y=$((uy + (uh - SNAP_TITLE_BAR - h) / 2))
      h=$((h + SNAP_TITLE_BAR)) ;;
    *) echo "Unknown zone: $zone" >&2; return 1 ;;
  esac
  y=$((y + SNAP_TITLE_BAR))
  h=$((h - SNAP_TITLE_BAR))
  mark_arranging

  [[ $(jq -r .fullscreen <<<"$info") != 0 ]] && hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"maximized\", window = \"address:$addr\" })" >/dev/null
  [[ $(jq -r .floating <<<"$info") == true ]] || hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$addr\" })" >/dev/null
  [[ -n ${SNAP_NO_FOCUS:-} ]] || hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null

  # Remember the pre-snap size (only the first time) so dragging it out restores it.
  json_set "$ZONES" '.[$a] = {ws: $ws, zone: $z, restore: (.[$a].restore // $size)}' \
    --arg a "$addr" --rawfile ws <(printf '%s' "$ws") --arg z "$zone" --argjson size "$(jq -c .size <<<"$info")"
}

# A window just opened on a workspace with snapped windows: snap it into a
# spot they leave free (the other half, else a free quarter), so a link
# clicked in an app snapped right opens on the left. Left alone: dialogs and
# utilities (Omarchy's floating-window tag, or another window of the same app
# already on the workspace), workspaces with a full-screen snap or nothing
# free, and everything once Settings turns it off.
fill_gap() {
  local addr=$1 info ws zones zone f
  [[ -f $FLAG ]] || return 0
  sleep 0.2   # let the window map and take its first size
  exec 9>"$STATE_DIR/fill.lock"
  flock 9
  # Hyprland reuses a closed window's address: whatever is recorded under it
  # (a zone, a place, a name) belonged to that window, so forget it.
  for f in "$ZONES" "$LAYOUT" "$NAMES"; do
    [[ -s $f ]] && json_set "$f" 'del(.[$a])' --arg a "$addr"
  done
  [[ ! -f $NO_FILL && -s $ZONES ]] || return 0
  local clients
  clients=$(hyprctl clients -j)
  info=$(jq -c --arg a "$addr" '.[] | select(.address == $a)' <<<"$clients")
  [[ -n $info ]] || return 0
  ws=$(jq -r .workspace.name <<<"$info")
  [[ $ws != special:* && $(jq -r '.fullscreen == 0 and (.tags | index("floating-window") | not)' <<<"$info") == true ]] || return 0
  jq -e --arg a "$addr" --argjson pid "$(jq .pid <<<"$info")" --rawfile ws <(printf '%s' "$ws") \
    'any(.[]; .address != $a and .pid == $pid and .workspace.name == $ws)' <<<"$clients" >/dev/null && return 0
  # the zones taken on this workspace, by windows still there
  zones=$(jq -c --rawfile ws <(printf '%s' "$ws") --argjson live "$(jq --rawfile ws <(printf '%s' "$ws") '[.[] | select(.workspace.name == $ws) | .address]' <<<"$clients")" \
    '[to_entries[] | select(.value.ws == $ws and (.key as $k | $live | index($k))) | .value.zone] | unique' "$ZONES")
  zone=$(jq -r '
    . as $z | def taken($s): any($z[]; . == $s);
    if length == 0 or taken("full") then empty
    elif ([taken("left"), taken("top-left"), taken("bottom-left")] | any | not) then "left"
    elif ([taken("right"), taken("top-right"), taken("bottom-right")] | any | not) then "right"
    else first(("top-left", "bottom-left", "top-right", "bottom-right")
      | select(. as $q | taken($q) | not)
      | select(if test("left") then (taken("left") | not) else (taken("right") | not) end)) // empty
    end' <<<"$zones")
  [[ -n $zone ]] && snap_window "$zone" "$addr"
}

# Dropped on a workspace box at the top of the screen: send the window to
# that workspace without following it, back where it was picked up (not
# under the boxes). A snapped window keeps its zone there.
send_window() {
  local ws=$1 addr=$2 x=${3:-} y=${4:-}
  [[ $ws =~ ^[1-9][0-9]{0,3}$ && $addr =~ ^0x[0-9a-f]+$ ]] || return 0
  mark_arranging
  [[ $x =~ ^-?[0-9]+$ && $y =~ ^-?[0-9]+$ ]] &&
    hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"$ws\", follow = false, window = \"address:$addr\" })" >/dev/null
  [[ -s $ZONES ]] && json_set "$ZONES" 'if has($a) then .[$a].ws = $ws else . end' --arg a "$addr" --arg ws "$ws"
  return 0
}

# Dragged out of its zone: back to the pre-snap size (at most 70% of the
# screen), keeping its top-left where it was dropped.
unsnap_window() {
  local addr=$1 size info w h x y mw mh
  [[ -s $ZONES ]] || return 0
  size=$(jq -r --arg a "$addr" '.[$a].restore // empty | "\(.[0]) \(.[1])"' "$ZONES")
  json_set "$ZONES" 'del(.[$a])' --arg a "$addr"
  [[ -n $size ]] || return 0
  info=$(hyprctl clients -j | jq -c --arg a "$addr" '.[] | select(.address == $a)')
  [[ -n $info ]] || return 0
  mark_arranging
  read -r x y < <(jq -r '"\(.at[0]) \(.at[1])"' <<<"$info")
  read -r mw mh < <(hyprctl monitors -j | jq -r --argjson id "$(jq .monitor <<<"$info")" \
    '.[] | select(.id == $id) | "\((.width / .scale) | floor) \((.height / .scale) | floor)"')
  [[ -n ${mh:-} ]] || return 0   # (the monitor just went away)
  w=${size% *} h=${size#* }
  [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || return 0
  (( w > mw * 7 / 10 )) && w=$((mw * 7 / 10))
  (( h > mh * 7 / 10 )) && h=$((mh * 7 / 10))
  hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$addr\" })" >/dev/null
}

# Studio's Hide (Super+H): minimize the app's windows on this workspace;
# Hide Others (Super+Alt+H): every other app's. Quit (Super+Q): close all of
# the app's windows, wherever they are.
app_windows() {  # app_windows <address> <same|others> [here]
  local addr=$1 which=$2 where=${3:-}
  # (one jq call keyed by the address: the app's class, which the app
  # chooses, stays inside jq rather than in a command line)
  hyprctl clients -j | jq -r --arg a "$addr" --arg which "$which" --arg where "$where" '
    (first(.[] | select(.address == $a)) // empty) as $me
    | select(($me.class // "") != "")
    | .[]
    | select(.workspace.id > 0 or .workspace.name == "special:minimized")
    | select(if $which == "same" then .class == $me.class else .class != $me.class end)
    | select($where != "here" or .workspace.name == $me.workspace.name)
    | .address'
}

hide_app() {
  local addr a
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] || return 0
  for a in $(app_windows "$addr" same here); do minimize_window "$a"; done
}

hide_others() {
  local addr a
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] || return 0
  for a in $(app_windows "$addr" others here); do minimize_window "$a"; done
}

quit_app() {
  local addr a
  addr=$(window_address "${1:-}")
  [[ -n $addr ]] || return 0
  for a in $(app_windows "$addr" same); do close_window "$a"; done
}

show_desktop() {
  local current windows
  current=$(hyprctl activeworkspace -j | jq -r '.name')
  windows=$(hyprctl activeworkspace -j | jq -r '.windows')
  if (( windows > 0 )); then
    mkdir -p -m 700 "$STATE_DIR"
    echo "$current" >"$DESKTOP_RETURN"
    hyprctl dispatch 'hl.dsp.focus({ workspace = "empty" })' >/dev/null
  elif [[ -f $DESKTOP_RETURN ]]; then
    current=$(<"$DESKTOP_RETURN")
    local lua
    if lua=$(ws_lua "$current"); then
      hyprctl dispatch "hl.dsp.focus({ workspace = $lua })" >/dev/null
      ws_lua_done "$lua"
    fi
    rm -f "$DESKTOP_RETURN"
  fi
}

# Style > Background: every wallpaper in one list, in groups, each named by
# where it comes from (the picker labels a picture by its file name):
#   1. this theme's own backgrounds   "Topside Mountain View (This Theme, Live)"
#   2. live wallpapers of your other themes, so a different live wallpaper
#      doesn't mean a different theme   "Topside Dusk (Live)" (Lite versions
#      share their picture, so they're left out)
#   3. the Classic and Studio pictures   "Classic: Hills Day"
#   4. every other theme's still backgrounds, Omarchy's own included,
#      so picking one doesn't mean switching theme   "Tokyo Night 2"
# Prints the picked file itself. `bg-picker cache` only makes the previews, so
# an opening after it doesn't wait for them; `bg-picker apply` puts the pick up.
pretty_name() {  # topside-mountain-view -> Topside Mountain View
  local word words out=()
  read -ra words <<<"${1//[-_]/ }"   # (not a bare expansion: a * in a name would match files)
  for word in "${words[@]}"; do out+=("${word^}"); done
  echo "${out[*]}"
}

# Omarchy's picker makes a preview of each picture in its own cache
# (`~/.cache/omarchy/image-selector`, a 0755 folder), as it does for Omarchy's
# own Background menu, with `vipsthumbnail` at the usual umask: 0644. For a
# picture of yours that's a copy other accounts could read. So here the picker
# runs under umask 077 (the preview makers it starts inherit it), and previews
# an earlier version left open are tightened before it runs: Omarchy's index
# (`index.tsv`: entry path, size and time, preview name) says which preview was
# made from which entry, and every entry of Overtake's list is under its own
# folder. Nothing else in Omarchy's cache is touched.
bg_tighten_previews() {  # bg_tighten_previews <list folder>: its entries' previews to 0600
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/image-selector" index name file files=()
  index="$dir/index.tsv"
  [[ -f $index && ! -L $index && -O $index ]] || return 0
  while IFS= read -r name; do
    file="$dir/$name.jpg"
    [[ -f $file && ! -L $file && -O $file ]] && files+=("$file")
  done < <(OV_LIST="$1/" awk -F '\t' 'BEGIN { p = ENVIRON["OV_LIST"] } index($1, p) == 1 && $3 ~ /^[0-9a-f]+$/ { print $3 }' "$index" 2>/dev/null | sort -u)
  (( ${#files[@]} )) && chmod 600 -- "${files[@]}" 2>/dev/null
  return 0
}

bg_link() {  # bg_link <group dir> <name> <file>: one entry for the list
  local link="$1/${2//\//-}.${3##*.}"   # (a / in a theme's name stays in the folder)
  BG_WANT[$link]=$3
  [[ $3 -ef $CURRENT_BG ]] && BG_SELECTED=$link
  return 0
}

# Make the links: each one pointing where it should, nothing else in the group
# folders. On stdin (link, target, NUL after each), so no picture's name is in
# a command line. Links change only when the pictures do.
bg_link_all() {  # bg_link_all <group dir>... (entries from BG_WANT)
  local link
  for link in "${!BG_WANT[@]}"; do printf '%s\0%s\0' "$link" "${BG_WANT[$link]}"; done |
    python3 -I -c '
import os, sys
items = sys.stdin.buffer.read().split(b"\0")[:-1]
want = dict(zip(items[0::2], items[1::2]))
for link, target in want.items():
    try:
        if os.readlink(link) == target:
            continue
    except OSError:
        pass
    temp = link + b".tmp"
    if os.path.lexists(temp):
        os.unlink(temp)
    os.symlink(target, temp)
    os.replace(temp, link)
for group in map(os.fsencode, sys.argv[1:]):
    for name in os.listdir(group):
        path = os.path.join(group, name)
        if path not in want:
            os.unlink(path)
' "$@"
}

# Terminal output is a sink: a file name can hold escape sequences.
has_control_chars() {  # (ASCII controls, and the ones UTF-8 can spell: U+0080 to U+009F)
  local LC_ALL=C
  [[ $1 == *[[:cntrl:]]* || $1 == *$'\xc2'[$'\x80'-$'\x9f']* ]]
}

# Settings' gallery draws a theme from git only from these: stripped and
# re-encoded here, in a child under a memory and time limit, as Omarchy's own
# picker does (vipsthumbnail ... [strip]). A crafted picture costs that child.
# (a crafted file makes the child abort under its memory limit. A core limit of 1 is
# the one value that stops a piped core handler, so there's no dump, and no "process
# crashed" notice for doing its job.)
theme_previews() {
  local dir theme name src out tmp f limits=()
  mapfile -t limits < <(child_limits)
  dir="${XDG_CACHE_HOME:-$HOME/.cache}/overtake/theme-previews"
  mkdir -p -m 700 "$dir"
  chmod 700 "$dir"
  for out in "$dir"/*.jpg; do   # (themes since removed)
    name=${out##*/}
    [[ ! -e $out || -d $HOME/.config/omarchy/themes/${name%.jpg} ]] || rm -f "$out"
  done
  command -v vipsthumbnail >/dev/null || return 0
  for theme in "$HOME/.config/omarchy/themes"/*/; do
    [[ -d $theme ]] || continue
    name=${theme%/}; name=${name##*/}
    has_control_chars "$name" && continue
    src=""
    for f in preview.jpg preview.png; do
      # (no links: git can carry one, to anywhere)
      [[ -f $theme$f && ! -L $theme$f ]] && { src=$theme$f; break; }
    done
    out="$dir/$name.jpg"
    [[ -n $src ]] || { rm -f "$out"; continue; }
    [[ $out -nt $src ]] && continue
    tmp=$(mktemp "$dir/.preview.XXXXXX.jpg") || continue
    if (( $(stat -c %s "$src") <= 33554432 )) &&
       ( exec env VIPS_CONCURRENCY=1 prlimit "${limits[@]}" timeout 20 vipsthumbnail "$src" --size 640x360 -o "$tmp[Q=82,strip]" ) >/dev/null 2>&1; then
      chmod 600 "$tmp"; mv -f "$tmp" "$out"
    else
      # (remembered as no picture, until the theme's file changes)
      rm -f "$tmp"; : >"$out"; chmod 600 "$out"
    fi
  done
}

# Stripped copies of the icons in your own folders, made by a child under limits, and
# the list a shell plugin draws them from (UserIcons.qml): a name's file is read
# through a redirect into a numbered temp, so no icon's name is in a command line.
# Exits non-zero when it couldn't scan (the lock busy for a minute, a full disk), so
# the shell doesn't take that for an answer.
# Limits for a child that reads a crafted file. A core limit of 1 stops a piped
# crash handler where 0 doesn't, but needs a hard limit above 0 to be allowed.
child_limits() {
  local core=1 memory=1073741824 hard
  [[ $(ulimit -Hc) != 0 ]] || core=0
  hard=$(ulimit -Hv)
  [[ $hard == unlimited ]] || (( hard * 1024 >= memory )) || memory=$((hard * 1024))
  printf '%s\n' "--core=$core:" "--as=$memory"
}

icon_copies() {
  local dir src name id tmp out count=0 limits=() again base
  local -a folders=() dirs=()
  local -A seen=() keep=()
  dir="${XDG_CACHE_HOME:-$HOME/.cache}/overtake/user-icons"
  # (the hicolor trees under your home, where installers save an app's icon: ~/.icons,
  # your data folder, any data folder of yours. A whole theme you installed is yours,
  # like the system's, and Qt draws it itself)
  IFS=: read -r -a dirs <<<"${XDG_DATA_DIRS:-}"
  for base in "$HOME/.icons" "${XDG_DATA_HOME:-$HOME/.local/share}/icons" "${dirs[@]/%//icons}"; do
    [[ $base == "$HOME"/* && -d $base/hicolor ]] && folders+=("$base/hicolor")
  done
  mkdir -p -m 700 "$dir"
  chmod 700 "$dir"
  mapfile -t limits < <(child_limits)
  (
    flock -w 60 9 || exit 3   # (one at a time; the next finds its work done)
    rm -f "$dir"/.index.* "$dir"/.icon.* "$dir"/*.new "$dir"/*.new.png     # (what a stopped scan or a full disk left)
    index=$(mktemp "$dir/.index.XXXXXX") || exit 4
    if (( ${#folders[@]} )); then
      while IFS= read -r -d '' src; do
        name=${src##*/}; name=${name%.*}
        [[ $name =~ ^[A-Za-z0-9_][A-Za-z0-9_.+-]{0,127}$ && -z ${seen[$name]:-} ]] || continue
        seen[$name]=1
        # (past the limit, or not a file, a pipe say: known, so never looked up, with no copy)
        if (( ++count > 500 )) || [[ ! -f $src ]]; then printf '%s\t\n' "$name" >>"$index"; continue; fi
        id=$(sha256sum <<<"$name"); id=${id%% *}; id=${id:0:32}.png
        out=$dir/$id; keep[$id]=1
        # (a file that made no copy is tried again after a day: it may have been a full disk)
        again=""; [[ -s $out || -z $(find "$out" -mmin +1440 2>/dev/null) ]] || again=1
        if [[ -n $again || ! $out -nt $src ]]; then
          tmp=$(mktemp "$dir/.icon.XXXXXX") || exit 4
          # (the type comes from what's in the file; over 32 MB isn't an icon; the child
          # sees only numbered temp names, so neither the name nor its hash is in its argv)
          if head -c 33554433 <"$src" >"$tmp" && (( $(stat -c %s "$tmp") <= 33554432 )) &&
             ( exec 9>&-; exec env VIPS_CONCURRENCY=1 prlimit "${limits[@]}" timeout 10 vipsthumbnail "$tmp" --size 256x256 -o "$tmp.png[strip]" ) >/dev/null 2>&1; then
            chmod 600 "$tmp.png"; mv -f "$tmp.png" "$out"
          else
            rm -f "$tmp.png"; : >"$out"; chmod 600 "$out"
          fi
          rm -f "$tmp"
        fi
        [[ -s $out ]] || id=""
        printf '%s\t%s\n' "$name" "$id" >>"$index"   # (a write that fails ends the scan: set -e)
      done < <(find -L "${folders[@]}" -maxdepth 5 ! -type d \( -name '*.png' -o -name '*.svg' -o -name '*.svgz' -o -name '*.jpg' -o -name '*.jpeg' -o -name '*.xpm' \) -print0 2>/dev/null | sort -zrV)
    fi
    chmod 600 "$index"; mv -f "$index" "$dir/index"
    for out in "$dir"/*.png; do [[ -n ${keep[${out##*/}]:-} ]] || rm -f "$out"; done   # (an icon that's gone takes its copy with it)
  ) 9>"$dir/.lock"
}

bg_picker() {
  shopt -s nullglob
  local theme theme_base cache dir file name base n link live suffix real pack
  declare -gA BG_WANT=()
  BG_SELECTED=""
  theme=$(cat "$CURRENT_THEME_NAME" 2>/dev/null || true)
  theme_base=${theme%-lite}
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/overtake/bg-picker"
  # links change only when the pictures do: unchanged folders let Omarchy's
  # picker reuse its list instead of rereading every picture
  mkdir -p "$cache/1-theme" "$cache/2-live" "$cache/3-overtake" "$cache/4-themes"

  n=0
  for file in "$HOME/.local/state/omarchy/current/theme/backgrounds"/* "$HOME/.config/omarchy/backgrounds/$theme"/*; do
    [[ -f $file && ${file,,} =~ \.(png|jpe?g|webp|gif|bmp|mp4|m4v|mov|webm|mkv|avi)$ ]] || continue   # (what Omarchy 4.5 lists, videos too)
    base=${file##*/}; base=${base%.*}
    [[ ${file##*/} == overtake-hills-day.png && -L $file ]] && continue   # (install's link: listed as Classic's)
    # a live background pack (linked here from ~/.config/omarchy/live-backgrounds)
    # goes in the Live group under its own name, through the same link
    # (compared with the shell's own -ef: no picture's path in a command line)
    pack=""
    for real in "$HOME/.config/omarchy/live-backgrounds"/*/backgrounds/"$base".*; do
      [[ $file -ef $real && -f ${real%/backgrounds/*}/live/$base.frag.qsb ]] || continue
      pack=${real%/backgrounds/*}; pack=${pack##*/}; break
    done
    if [[ -n $pack ]]; then
      bg_link "$cache/2-live" "$(pretty_name "$pack") (Live)" "$file"
      continue
    fi
    n=$((n + 1))
    live=""
    [[ -f ${file%/backgrounds/*}/live/$base.frag.qsb ]] && live=", Live"
    suffix=""; (( n > 1 )) && suffix=" $n"
    bg_link "$cache/1-theme" "$(pretty_name "$theme")$suffix (This Theme$live)" "$file"
  done

  for dir in "${OMARCHY_PATH:-/usr/share/omarchy}/themes"/*/ "$HOME/.config/omarchy/themes"/*/; do
    dir=${dir%/}; name=${dir##*/}
    [[ $name == *-lite || $name == "$theme_base" ]] && continue
    n=0
    for file in "$dir"/live/*.frag.qsb; do
      base=${file##*/}; base=${base%.frag.qsb}
      for link in "$dir/backgrounds/$base".{png,jpg,jpeg,webp}; do
        [[ -f $link ]] || continue
        n=$((n + 1)); suffix=""; (( n > 1 )) && suffix=" $n"
        bg_link "$cache/2-live" "$(pretty_name "$name")$suffix (Live)" "$link"
        break
      done
    done
  done

  local added=0
  for dir in slideshow:Classic studio:Studio; do
    for file in "$HOME/Pictures/overtake/${dir%%:*}"/*; do
      [[ -f $file && ${file,,} =~ \.(png|jpe?g|webp)$ ]] || continue
      base=${file##*/}; base=${base%.*}
      # (Omarchy's picker takes its labels as arguments: a picture you added
      # here goes by a number, its name stays out of the process list)
      case $base in
        1-hills-day|2-hills-night|3-shine|4-chips|5-beach|6-cave|7-snow-leopard)
          base=${base#[0-9]-}; bg_link "$cache/3-overtake" "${dir#*:}: $(pretty_name "$base")" "$file" ;;
        *) added=$((added + 1)); bg_link "$cache/3-overtake" "${dir#*:}: Picture $added" "$file" ;;
      esac
    done
  done

  for dir in "${OMARCHY_PATH:-/usr/share/omarchy}/themes"/*/ "$HOME/.config/omarchy/themes"/*/; do
    dir=${dir%/}; name=${dir##*/}
    [[ $name == *-lite || $name == "$theme_base" ]] && continue
    n=0
    for file in "$dir"/backgrounds/*; do
      [[ -f $file && ${file,,} =~ \.(png|jpe?g|webp|gif|bmp|mp4|m4v|mov|webm|mkv|avi)$ ]] || continue   # (what Omarchy 4.5 lists, videos too)
      base=${file##*/}; base=${base%.*}
      [[ -f $dir/live/$base.frag.qsb ]] && continue   # listed under 2 already
      n=$((n + 1)); suffix=""; (( n > 1 )) && suffix=" $n"
      bg_link "$cache/4-themes" "$(pretty_name "$name")$suffix" "$file"
    done
  done

  # (Omarchy's picker looks the selected one up with `find -samefile <its real path>`:
  # one of yours isn't named to it, so it isn't marked in the list)
  local real
  real=$(readlink -f "$CURRENT_BG" 2>/dev/null) || real=""
  case $real in
    "$HOME"/Pictures/overtake/*)
      case ${real##*/} in
        1-hills-day.*|2-hills-night.*|3-shine.*|4-chips.*|5-beach.*|6-cave.*|7-snow-leopard.*) ;;
        *) BG_SELECTED="" ;;
      esac ;;
    */omarchy/themes/*|*/omarchy/current/theme/*|*/omarchy/live-backgrounds/*) ;;
    *) BG_SELECTED="" ;;
  esac
  local groups=("$cache/1-theme" "$cache/2-live" "$cache/3-overtake" "$cache/4-themes")
  bg_link_all "${groups[@]}"
  bg_tighten_previews "$cache"   # (and the picker runs under umask 077 below: see bg_tighten_previews)
  if [[ ${1:-} == cache ]]; then
    (umask 077; omarchy-menu-images --cache-only "${groups[@]}") >/dev/null 2>&1 || true
    return 0
  fi
  local picked
  picked=$(umask 077; omarchy-menu-images --show-labels --lazy-thumbnails --selected "$BG_SELECTED" "${groups[@]}") || return 0
  [[ -n $picked ]] || return 0
  picked=${BG_WANT[$picked]:-$picked}
  # `bg-picker apply` (the desktop's Change background) puts it up itself
  if [[ ${1:-} == apply ]]; then
    mark_picked
    set_background "$picked"
    return
  fi
  if has_control_chars "$picked"; then
    echo "overtake: that picture's file name has control characters; rename it first" >&2
    return 1
  fi
  mark_picked
  printf '%s\n' "$picked"
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

# Window addresses and workspace names end up inside the Lua that
# `hyprctl dispatch` runs: take addresses only in Hyprland's own form.
case ${1:-} in
  minimize|restore|show|make-room|maximize|close|unsnap|copy-url|fill-gap|rename|hide-app|hide-others|quit-app)
    [[ -z ${2:-} || $2 =~ ^0x[0-9a-fA-F]+$ ]] || { echo "overtake $1: not a window address: $2" >&2; exit 1; } ;;
  name)
    [[ -z ${2:-} || $2 == here || $2 =~ ^0x[0-9a-fA-F]+$ ]] || { echo "overtake name: not a window address: $2" >&2; exit 1; } ;;
  snap|send)   # the window is the second argument (after the zone, or the workspace)
    [[ -z ${3:-} || $3 =~ ^0x[0-9a-fA-F]+$ ]] || { echo "overtake $1: not a window address: $3" >&2; exit 1; } ;;
esac

# A notice that couldn't be shown earlier (notify_kept): now, if the shell is up.
[[ ! -s $PENDING_NOTICES ]] || show_pending_notices

case "${1:-help}" in
  help|-h|--help) usage ;;
  build-copies) build_copies "${2:-update}" ;;   # installer (all) and the post-update hook (update)
  copies) [[ ${2:-} == on || ${2:-} == off ]] && switch_copies "$2" ;;   # (the installer: Overtake's service copies on or off)
  uninstall)
    shift
    [[ -x $HOME/.local/share/overtake/uninstall.sh ]] || { echo "overtake: the uninstaller isn't installed; run ./uninstall.sh from the repository" >&2; exit 1; }
    exec "$HOME/.local/share/overtake/uninstall.sh" "$@" ;;
  on) mode_lock; turn_on ;;
  off) mode_lock; turn_off ;;
  toggle) mode_lock; if [[ -f $FLAG ]]; then turn_off; else turn_on; fi ;;
  cycle) mode_lock; cycle_mode ;;
  status) [[ -f $FLAG ]] && echo on || echo off ;;
  fix-bar) mode_lock; fix_bar_widgets ;;   # also run by the shell when the bar settings change
  style) if [[ -n ${2:-} ]]; then mode_lock; set_style "${2,,}"; else style; fi ;;
  studio-get) studio_get "${2:-}" ;;
  studio-set) studio_set "${2:-}" "${3:-}" ;;
  resume-wallpaper) [[ ${2:-} == refresh ]] && refresh_wallpaper; start_slideshow ;;   # internal: after a look change
  show-desktop) show_desktop ;;
  bg-picker) bg_picker "${2:-}" ;;
  theme-previews) theme_previews ;;
  icon-copies) icon_copies ;;
  next-wallpaper)
    if [[ ! -f $FLAG ]]; then :
    elif [[ $(wallpaper_mode) == day-night ]] && picked_wallpaper; then apply_day_night   # back from a picked wallpaper
    elif [[ $(wallpaper_mode) == day-night ]]; then notify $'' "Day & Night wallpaper follows the sun (switch to Rotate in the Overtake Mode menu)"
    else next_wallpaper; fi ;;
  wallpaper-mode) if [[ -n ${2:-} ]]; then set_wallpaper_mode "$2"; else wallpaper_mode; fi ;;
  resume)
    # The copies follow Omarchy even when it was updated without `omarchy
    # update` (a plain system upgrade): rebuilt at login if Omarchy's code changed.
    build_copies update >/dev/null 2>&1 || true
    repair_stale_copies
    if [[ -f $FLAG ]]; then fix_bar_widgets; [[ $(wallpaper_mode) == day-night ]] && ! picked_wallpaper && apply_day_night; start_slideshow; float_all; rescue_all; fi
    # A notice the shell wasn't up for yet: try again while it starts (in
    # Omarchy mode no other `overtake` command may run for a long time).
    if [[ -s $PENDING_NOTICES ]]; then
      setsid sh -c 'for i in 1 2 3 4 5 6; do sleep 10; overtake status; done' </dev/null >/dev/null 2>&1 &
    fi ;;
  minimize) minimize_window "${2:-}" ;;
  restore) [[ -n ${2:-} ]] && restore_window "$2" "${3:-follow}" || true ;;
  restore-all) restore_all ;;
  minimize-all) minimize_all "${2:-}" ;;
  focus-app) [[ -n ${2:-} ]] && focus_app "$2" ;;
  notification-open) notification_open ;;
  notify-stdin)   # one notification from JSON on stdin ({app, icon, urgency, summary, body}):
    # its text never goes into a command line; sent over D-Bus from here
    python3 -I -c '
import json, sys
from gi.repository import Gio, GLib
n = json.loads(sys.stdin.read(65536) or "{}")
urgency = {"low": 0, "normal": 1, "critical": 2}.get(str(n.get("urgency", "normal")), 1)
Gio.bus_get_sync(Gio.BusType.SESSION, None).call_sync(
    "org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.freedesktop.Notifications", "Notify",
    GLib.Variant("(susssasa{sv}i)", (str(n.get("app", ""))[:64], 0, str(n.get("icon", ""))[:256],
                 str(n.get("summary", ""))[:512], str(n.get("body", ""))[:2048], [],
                 {"urgency": GLib.Variant("y", urgency)}, -1)),
    None, Gio.DBusCallFlags.NONE, 5000, None)
' 2>/dev/null ;;   # (exit 1, quietly, when there's no notification service)
  screensaver) shift; screensaver_cmd "$@" ;;
  hide-minimized) hide_minimized ;;
  show) [[ -n ${2:-} ]] && show_window "$2" || true ;;
  rescue) rescue_all ;;
  make-room) [[ -n ${2:-} ]] && make_room "$2" || true ;;
  remember) [[ -f $FLAG ]] && remember_layout || true ;;
  relayout) [[ -f $FLAG ]] && relayout "${2:-}" || true ;;
  float-all) [[ -f $FLAG ]] && float_all || true ;;
  maximize) maximize_window "${2:-}" ;;
  close) close_window "${2:-}" ;;
  snap) [[ -n ${2:-} ]] && snap_window "$2" "${3:-}" || true ;;
  unsnap) [[ -n ${2:-} ]] && unsnap_window "$2" || true ;;
  unsnap-active) addr=$(window_address ""); [[ -n $addr ]] && unsnap_window "$addr" || true ;;
  send) [[ -n ${3:-} ]] && send_window "$2" "$3" "${4:-}" "${5:-}" || true ;;
  snap-layouts) mkdir -p -m 700 "$STATE_DIR"; date +%s%N >"$STATE_DIR/snap-request" ;;
  taskbar-position) taskbar_position "${2:-}" ;;
  copy-url) [[ -n ${2:-} ]] && copy_url "$2" || true ;;
  fill-gap) [[ -n ${2:-} ]] && fill_gap "$2" || true ;;
  rename)
    addr=$(window_address "${2:-}")
    [[ -n $addr ]] && { show_window "$addr"; mkdir -p -m 700 "$STATE_DIR"; echo "$addr $(date +%s%N)" >"$STATE_DIR/rename-request"; } || true ;;
  name)
    addr=${2:-}
    [[ $addr == here ]] && addr=$(window_here)
    # the name only on stdin ("-", one line; no name clears it), never as an
    # argument, where other accounts could read it in the process list
    [[ -z ${3:-} || ${3:-} == - ]] || { echo "overtake name: give the name on stdin: echo NAME | overtake name ${2:-here} -" >&2; exit 1; }
    name=""; [[ ${3:-} == - ]] && { IFS= read -r -t 5 name || true; }
    [[ -n $addr ]] && set_name "$addr" "$name" || { [[ ${2:-} == here ]] && echo "overtake: no window found for this process" >&2; true; } ;;
  start)
    mkdir -p -m 700 "$STATE_DIR"
    # Studio has no Start menu: Spotlight (and its Apps view) stands in.
    if [[ $(style) == studio ]]; then
      case ${2:-start} in all) set -- ui apps ;; quick) set -- ui app-menu ;; *) set -- ui spotlight ;; esac
      echo "$2 $(date +%s%N)" >"$STATE_DIR/ui-request"
    else
      echo "${2:-start} $(date +%s%N)" >"$STATE_DIR/start-request"
    fi ;;
  ui)
    mkdir -p -m 700 "$STATE_DIR"
    what=${2:-spotlight}
    # A quick Super+Tab: Super comes up right after Tab, and the shell may
    # read the file only once both have been written. Say both in one.
    if [[ $what == switcher-commit && -s $STATE_DIR/ui-request ]]; then
      read -r last when <"$STATE_DIR/ui-request" || true
      [[ $last == switcher* && $last != switcher-commit && $when =~ ^[0-9]+$ ]] &&
        (( $(date +%s%N) - when < 500000000 )) && what=switcher-quick
    fi
    echo "$what $(date +%s%N)" >"$STATE_DIR/ui-request" ;;
  hide-app) hide_app "${2:-}" ;;
  hide-others) hide_others "${2:-}" ;;
  quit-app) quit_app "${2:-}" ;;
  settings) mkdir -p -m 700 "$STATE_DIR"; echo "${2:-open} $(date +%s%N)" >"$STATE_DIR/settings-request" ;;
  slideshow-loop) slideshow_loop ;;   # internal: the slideshow's background loop
  *) echo "overtake: unknown command '$1' (overtake help lists them)" >&2; exit 1 ;;
esac
